def _synonymes_perso() -> list[set[str]]:
    """Groupes en plus, propres à un projet (« relecteur, relecture, revue-de-code ») : un groupe par ligne, mots
    séparés par des virgules, « # » pour un commentaire. $MEM_SYNONYMES, sinon ~/.config/mem/synonymes.txt."""
    defaut = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "mem" / "synonymes.txt"
    try:
        lignes = Path(os.environ.get("MEM_SYNONYMES") or defaut).read_text(encoding="utf-8").splitlines()
    except (OSError, ValueError) as e:  # ValueError : fichier pas en UTF-8 ; mem doit marcher quand même
        if not isinstance(e, FileNotFoundError):
            print(tr(f"mem : synonymes ignorés ({type(e).__name__})", f"mem: synonyms ignored ({type(e).__name__})"),
                  file=sys.stderr)
        return []
    groupes = ({m.strip().lower() for m in l.split(",") if m.strip()} for l in lignes if not l.lstrip().startswith("#"))
    return [g for g in groupes if len(g) > 1]



