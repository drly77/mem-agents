# Une ligne qui correspond à l'un de ces motifs n'est jamais indexée.
# Une valeur, pas une commande ($(…)), un chemin, un renvoi ni une valeur déjà masquée.
VALEUR = r"(?P<v>[\"']?(?![$~/.<(]|\[masqué\])[^\s\"'<>…]{6,})"
VALEUR_COURTE = VALEUR.replace("{6,}", "{4,}")  # après « mot de passe : » ou « mdp = » : hunter2 compte aussi
# Après « est » / « vaut » : de la prose (« le mot de passe est requis »). Est pris pour un secret : une valeur
# entre guillemets (4 caractères), ou de 6 caractères avec un chiffre ou un signe, ou une majuscule après une
# minuscule (« hunTer », casse stricte : la règle est compilée en re.I). Un mot en minuscules seules (« hunter ») reste gardé : rien ne le distingue de
# « requis » ou « changé » (compromis voulu).
_LETTRES = "A-Za-zÀ-ÖØ-öø-ÿŒœ"
VALEUR_PROSE = (r"(?P<v>(?:"
                r"[\"'«`]\s?(?![$~/.<(]|\[masqué\])[^\s\"'<>…»`]{4,}\s?[\"'»`]"
                r"|[\"']?(?![$~/.<(]|\[masqué\])(?=[^\s]*[^\s" + _LETTRES + r"\"'<>…])[^\s\"'<>…]{6,}"
                r"|[\"']?(?![$~/.<(]|\[masqué\])(?-i:(?=[^\s]*[a-zß-öø-ÿœ][A-ZÀ-ÖØ-ÞŒ]))[^\s\"'<>…]{6,}"
                r"))")
MASQUE = "[masqué]"
RETIRER = {"clé privée", "corps de clé"}  # ligne entière retirée ; ailleurs seule la valeur est masquée
# Étiquette explicite d'un secret ; « auth_token », « db_password » comptent aussi (préfixe en _), « token_count » non.
LABEL_SECRET = (r"(?<![A-Za-z0-9])(?:[A-Za-z0-9]+_)*(password|passwd|passphrase|secret(?:[_ -]?key)?|token|jeton"
                r"|api[_ -]?key|cl[eé][_ -]?(?:api|secr[eè]te|priv[eé]e)|mot[_ -]?de[_ -]?passe|motdepasse|mdp)\b")
SECRETS = [
    ("clé privée", re.compile(r"PrivateKey\s*=|-----BEGIN [A-Z0-9 _-]*PRIVATE KEY", re.I)),
    ("jeton", re.compile(
        r"\b(sk-[A-Za-z0-9_-]{20,}|sk_(?:live|test|or)_[A-Za-z0-9_-]{10,}|gh[pousr]_[A-Za-z0-9]{20,}"
        r"|github_pat_[A-Za-z0-9_]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}|xapp-[A-Za-z0-9-]{10,}"
        r"|AGE-SECRET-KEY-1[0-9A-Z]{50,}|hf_[A-Za-z]{30,}|api_org_[A-Za-z]{30,}|hv[sb]\.[A-Za-z0-9_-]{24,}"
        r"|ZXlK[A-Za-z0-9+/=]{20,}|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{10,}(?:\.[A-Za-z0-9_-]+)?|(?:AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}"
        r"|AIza[0-9A-Za-z_-]{30,}|\d{8,10}:AA[A-Za-z0-9_-]{30,})")),
    ("bcrypt", re.compile(r"\$2[aby]\$\d\d\$[./A-Za-z0-9]{20,}")),
    ("url à identifiants", re.compile(r"://[^/\s:@]+:[^/\s@]+@|\bcurl\b.*\s-u\s*\S+:\S+")),
    ("authorization", re.compile(r"Authorization:\s*(Bearer|Basic|Token)\s+\S{8,}", re.I)),
    ("json", re.compile(r"\"(token|password|secret|api[_-]?key|access[_-]?key)\"\s*:\s*\"[^\"]{6,}\"", re.I)),
    ("mot de passe", re.compile(
        LABEL_SECRET +
        r"[^\n:=]{0,40}?\s*[:=]\s*" + VALEUR_COURTE, re.I)),
    ("mot de passe", re.compile(  # « … est … » / « … vaut … » : de la prose, donc 6 caractères au moins et sans « jeton »
        r"\b(password|passwd|passphrase|secret|token|api[_-]?key|cle[_-]?api|clé[_ ]api|mot de passe|mdp)\b" +
        r"[^\n:=]{0,40}?(\s+est\s+|\s+vaut\s+)" + VALEUR_PROSE, re.I)),
    ("corps de clé", re.compile(r"^\s*[A-Za-z0-9+/]{60,}={0,2}\s*$")),
    ("variable secrète", re.compile(r"\b[A-Za-z0-9_]*(KEY|TOKEN|SECRET|PASSWORD|PASSWD|_PASS|cle_api)\s*=\s*" + VALEUR)),
