            import io

            un, deux = Path(tmp) / "p1.md", Path(tmp) / "p2.md"
            un.write_text("## POINT DE REPRISE 01/01 10h00\n- prod = abc123\n- prod = abc123\n", encoding="utf-8")
            deux.write_text("## POINT DE REPRISE 02/01 11h00\n- prod = def456\n", encoding="utf-8")
            with contextlib.redirect_stdout(io.StringIO()):
                ok1, ok2 = point(racine, str(un), fichier_verrou=Path(tmp) / "v"), point(racine, str(deux), fichier_verrou=Path(tmp) / "v")
            note_p, arch_p = (racine / POINT_NOTE).read_text(), (racine / POINT_ARCHIVE).read_text()
            cas("point : créé puis remplacé", ok1 == 0 and ok2 == 0 and note_p.startswith("---\nname: point-de-reprise")
                and "def456" in note_p and "abc123" not in note_p)
            cas("point : ancien point archivé mot pour mot (doublons compris)",
                arch_p.count("- prod = abc123") == 2 and "## POINT DE REPRISE 01/01 10h00" in arch_p)
            import shutil

            if shutil.which("git"):
                ident = {**os.environ, "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t",
                         "GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@t"}
                g = lambda *a: subprocess.run(["git", "-C", str(racine), *a], capture_output=True, text=True, env=ident)  # noqa: E731
                g("init", "-q"), g("add", "-A"), g("commit", "-qm", "init")
                (racine / "project" / "autre.md").write_text("en cours\n", encoding="utf-8")
                g("add", "project/autre.md")
                trois = Path(tmp) / "p2b.md"
                trois.write_text("## POINT DE REPRISE 02/01 12h00\n- prod = ghi789\n", encoding="utf-8")
                ancien_env = os.environ.copy()
                os.environ.update(ident)
                try:
                    with contextlib.redirect_stdout(io.StringIO()):
                        point(racine, str(trois), fichier_verrou=Path(tmp) / "v")
                finally:
                    os.environ.clear(), os.environ.update(ancien_env)
                dernier = g("show", "--name-only", "--format=", "HEAD").stdout.split()
                cas("point : le commit n'emporte que la note et l'archive",
                    sorted(dernier) == sorted([POINT_ARCHIVE, POINT_NOTE]) and "project/autre.md" in g("diff", "--cached", "--name-only").stdout)
                note_p = (racine / POINT_NOTE).read_text()
            else:
                print("(sauté : commit limité de mem point, git absent)")
            mauvais = Path(tmp) / "p3.md"
            with contextlib.redirect_stderr(io.StringIO()):
                cas("point : fichier absent, code 2 sans trace", point(racine, str(Path(tmp) / "absent.md"),
                                                                     fichier_verrou=Path(tmp) / "v") == 2)
            for nom, contenu in (("point : sans titre « POINT DE REPRISE » refusé", "## Notes\nx\n"),
                                 ("point : secret refusé, rien d'écrit", "## POINT DE REPRISE 03/01\nmot de passe : hunter2\n")):
                mauvais.write_text(contenu, encoding="utf-8")
                with contextlib.redirect_stderr(io.StringIO()):
                    cas(nom, point(racine, str(mauvais), fichier_verrou=Path(tmp) / "v") == 2 and (racine / POINT_NOTE).read_text() == note_p)
            # Reclassement : un faux reclasseur (note = numéro du passage) et un reclasseur absent.
            lignes = [(f"n{i}.md", 1, "", "project", f"t{i}", "texte", 0.0) for i in range(K_RECLASSE + 2)]
            SOCKET_RECLASSEUR = Path(tmp) / "pas-de-serveur.sock"  # jamais le vrai service pendant le selftest
            RECLASSEUR = Path(tmp) / "absent"
            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                cas("reclasser : reclasseur absent, ordre inchangé et avis", reclasser("q", lignes) == lignes
                    and "reclassement indisponible" in err.getvalue())
            if node_pour_reclasser():
                RECLASSEUR = Path(tmp) / "faux"
                RECLASSEUR.mkdir()
                (RECLASSEUR / "reclasser.mjs").write_text(
                    'import fs from "node:fs"; const {docs} = JSON.parse(fs.readFileSync(0, "utf8"));'
                    " process.stdout.write(JSON.stringify(docs.map((_, i) => i)));")
                sortie = reclasser("q", lignes)
                cas("reclasser : le passage le mieux noté remonte en tête",
                    sortie[0] == lignes[K_RECLASSE - 1] and sorted(sortie) == sorted(lignes)
                    and sortie[K_RECLASSE:] == lignes[K_RECLASSE:])
            else:
                print("(sauté : reclasser avec un faux reclasseur, node absent)")
    finally:
        RECLASSEUR, SOCKET_RECLASSEUR = ancien_dossier, ancien_socket
        for cle, val in (("MEM_SENS", ancien), ("MEM_RECLASSER", ancien_r)):
            if val is None:
                os.environ.pop(cle, None)
            else:
                os.environ[cle] = val
    print(f"\n{'aucun échec' if not echecs else str(len(echecs)) + ' échec(s)'}")
    return 1 if echecs else 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="mem", description=__doc__.splitlines()[0])
    ap.add_argument("--dossier", type=Path, help="dossier mémoire (sinon détecté, voir mem --help)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    commun = argparse.ArgumentParser(add_help=False)  # « mem chercher --dossier D … » marche aussi
    commun.add_argument("--dossier", type=Path, default=argparse.SUPPRESS, help="dossier mémoire")
    c = sub.add_parser("chercher", parents=[commun])
    c.add_argument("mots", nargs="+")
    c.add_argument("--n", type=int, default=5)
    c.add_argument("--type")
    c.add_argument("--depuis")
    c.add_argument("--archives", action="store_true", help="chercher aussi dans archive/ d'emblée")
    c.add_argument("--dans", help="seulement ce sous-dossier (project/) ou cette note (project/x.md)")
    c.add_argument("--tous", action="store_true", help="notes de tous les auteurs, et les dossiers de ~/.config/mem/dossiers")
    c.add_argument("--vite", action="store_true", help="sans reclassement par le modèle local (0,3 s au lieu de ~8 s)")
    v = sub.add_parser("voir", parents=[commun])
    v.add_argument("cible")
    a = sub.add_parser("ajouter", parents=[commun])
    a.add_argument("--type", required=True, choices=["user", "feedback", "project", "reference"])
    a.add_argument("titre")
    a.add_argument("--quand-meme", action="store_true", help="écrire même si une note proche existe déjà")
    vs = sub.add_parser("voisins", parents=[commun], help="notes proches d'une note (doublon avant de la garder)")
    vs.add_argument("note")
    vs.add_argument("--seuil", type=float, default=VOISINS_SEUIL)
    sub.add_parser("indexer", parents=[commun])
    sub.add_parser("etat", parents=[commun])
    per = sub.add_parser("perimes", parents=[commun], help="notes qui renvoient à ce qui n'existe plus")
    per.add_argument("--depot", type=Path, action="append", help="dépôt git où chercher fichiers et commits (répétable)")
    per.add_argument("--n", type=int, default=30, help="notes affichées")
    per.add_argument("--dans", help="seulement ce sous-dossier (project/) ou cette note")
    dbl = sub.add_parser("doublons", parents=[commun], help="notes qui se répètent ou se contredisent (par le sens)")
    dbl.add_argument("--seuil", type=float, default=DOUBLONS_SEUIL, help=f"cosinus minimal (défaut {DOUBLONS_SEUIL})")
    dbl.add_argument("--n", type=int, default=20, help="paires de notes affichées")
    dbl.add_argument("--dans", help="seulement ce sous-dossier (feedback/) ou cette note")
    sub.add_parser("selftest", parents=[commun])
    b = sub.add_parser("bench", parents=[commun])
    b.add_argument("questions", type=Path)
    b.add_argument("--n", type=int, default=10)
    pt = sub.add_parser("point", parents=[commun], help="point de reprise neuf (avant /clear ou /compact)")
    pt.add_argument("fichier", help="fichier du point neuf, ou « - » pour l'entrée standard")
    pt.add_argument("--note", default=POINT_NOTE, help=f"note du point, relative au dossier ({POINT_NOTE})")
    pt.add_argument("--archive", default=POINT_ARCHIVE, help=f"archive des anciens points ({POINT_ARCHIVE})")
    pt.add_argument("--auteur", default="", help="nom de l'agent, repris dans le commit et l'archive")
    p = sub.add_parser("verifier-perte", parents=[commun])
    p.add_argument("avant", type=Path)
    p.add_argument("apres", type=Path)
    args = ap.parse_args(argv)

    if args.cmd == "selftest":
        return selftest()
    if args.cmd == "verifier-perte":
        return verifier_perte(args.avant, args.apres)
    racine = args.dossier or dossier_par_defaut()
    if racine is None or not racine.expanduser().is_dir():
        print(f"mem : aucun dossier mémoire trouvé depuis {Path.cwd()} ; donner --dossier ou MEM_DIR", file=sys.stderr)
        return 2
    racine = racine.expanduser()
    base = base_par_defaut(racine)
    if args.cmd == "chercher":
        args.mots = " ".join(args.mots)
        auteur = None if args.tous else (os.environ.get("AGENT_NOM") or None)
        dans = None
        if args.dans is not None:
            dans = normaliser_dans(racine, args.dans)
            if dans is None:
                sous = sorted(d.name + "/" for d in racine.iterdir() if d.is_dir() and not d.name.startswith("."))
                print(f"mem : « {args.dans} » n'existe pas dans {racine} (dossiers : {', '.join(sous) or 'aucun'})",
                      file=sys.stderr)
                return 2
        print(f"(mémoire : {racine}" + (f", dans {dans}" if dans else "") + ")", file=sys.stderr)
        afficher(chercher(racine, base, args.mots, args.n, args.type, args.depuis, args.archives, auteur,
                          reclasse=not args.vite, dans=dans))
        if args.tous:
            liste = Path.home() / ".config" / "mem" / "dossiers"
            try:
                autres = [l.strip() for l in liste.read_text(encoding="utf-8").splitlines() if l.strip()]
            except FileNotFoundError:
                autres = []
            except (OSError, ValueError) as e:
                print(f"mem : {liste} illisible ({type(e).__name__}), --tous limité à ce dossier", file=sys.stderr)
                autres = []
            for autre in autres:
                autre = Path(autre).expanduser()
                if autre.is_dir() and autre.resolve() != racine.resolve():
                    print(f"── {autre}", file=sys.stderr)  # stdout : les résultats seulement
                    afficher(chercher(autre, base_par_defaut(autre), args.mots, args.n, args.type, args.depuis, args.archives,
                                      reclasse=not args.vite, dans=dans))
    elif args.cmd == "voir":
        return voir(racine, base, args.cible)
    elif args.cmd == "ajouter":
        print(ajouter(racine, args.type, args.titre, sys.stdin.read(), base, args.quand_meme))
    elif args.cmd == "voisins":
        return voisins(racine, base, args.note, args.seuil)
    elif args.cmd == "indexer":
        total, refus = indexer(racine, base)
        print(f"{total} passages indexés, {refus} lignes refusées")
    elif args.cmd == "etat":
        etat(racine, base)
    elif args.cmd == "perimes":
        dans = None
        if args.dans is not None:
            dans = normaliser_dans(racine, args.dans)
            if dans is None:
                print(f"mem : « {args.dans} » n'existe pas dans {racine}", file=sys.stderr)
                return 2
        return perimes(racine, [d.expanduser() for d in args.depot] if args.depot else None, args.n, dans)
    elif args.cmd == "doublons":
        dans = None
        if args.dans is not None:
            dans = normaliser_dans(racine, args.dans)
            if dans is None:
                print(f"mem : « {args.dans} » n'existe pas dans {racine}", file=sys.stderr)
                return 2
        return doublons(racine, base, args.seuil, args.n, dans)
    elif args.cmd == "point":
        return point(racine, args.fichier, args.note, args.archive, args.auteur)
    elif args.cmd == "bench":
        return bench(racine, base, args.questions, args.n)
    return 0


if __name__ == "__main__":
    sys.exit(main())
