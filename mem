CONV_SOURCE = Path(os.environ.get("MEM_RETROUVER_SOURCE", Path.home() / ".claude" / "projects"))
CONV_BASE = Path(os.environ.get("MEM_RETROUVER_DB", Path.home() / ".local" / "share" / "mem" / "conversations.db"))
