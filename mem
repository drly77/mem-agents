def est_sous_suite(petite: list[str], grande: list[str]) -> bool:
    it = iter(grande)
    return all(any(x == y for y in it) for x in petite)


def verifier_perte(avant: Path, apres: Path) -> int:
    """Rien de perdu : chaque ligne d'avant, doublons compris, existe autant de fois après ; et l'ordre des
    lignes de chaque note est conservé dans la note vivante suivie de ses archives (ou l'inverse).
    Code 2 si AVANT ou APRÈS n'est pas un dossier, ou si AVANT n'a aucune note : une faute de frappe ne passe
    jamais pour « rien de perdu »."""
    for nom, d in (("AVANT", avant), ("APRÈS", apres)):
        if not d.is_dir():
            print(f"mem verifier-perte : {nom} {d} n'est pas un dossier", file=sys.stderr)
            return 2
    if not notes(avant):
        print(f"mem verifier-perte : aucune note .md dans AVANT {avant}", file=sys.stderr)
        return 2

    def lire(p: Path) -> list[str]:
        return [l.rstrip() for l in p.read_text(encoding="utf-8", errors="replace").splitlines() if l.strip()]

    compte_apres = collections.Counter()
    fichiers_apres = {str(p.relative_to(apres)): lire(p) for p in notes(apres)}
    for lignes in fichiers_apres.values():
        compte_apres.update(lignes)
    # Tables faites une fois (et non à chaque note d'avant) : archives triées, fichiers d'après par nom.
    archives_apres = sorted((r, ls) for r, ls in fichiers_apres.items() if r.startswith("archive/"))
    par_nom = collections.defaultdict(list)
    for r, ls in fichiers_apres.items():
        par_nom[Path(r).name].append(ls)
    compte_avant = collections.Counter()
    problemes = []
    for p in notes(avant):
        rel = str(p.relative_to(avant))
        lignes = lire(p)
        compte_avant.update(lignes)
        vivant = fichiers_apres.get(rel, [])
        archives = [l for r, ls in archives_apres if Path(r).stem.startswith(p.stem) for l in ls]
        if not (est_sous_suite(lignes, vivant + archives) or est_sous_suite(lignes, archives + vivant)
                or any(est_sous_suite(lignes, ls) for ls in par_nom[p.name])):
            problemes.append(f"ordre ou contenu changé : {rel}")
    manque = compte_avant - compte_apres
    for ligne, nb in list(manque.items())[:50]:
        problemes.append(f"perdue ×{nb} : {ligne[:120]}")
    for x in problemes[:60]:
        print(x)
    print(f"lignes perdues : {sum(manque.values())} ; notes en désordre : {sum(x.startswith('ordre') for x in problemes)}")
    return 1 if problemes else 0



DOUBLONS_SEUIL = 0.88  # cosinus ; réglé sur la mémoire du laptop (0,85 : encore juste ; 0,88 : presque aucun faux)
VOISINS_SEUIL = 0.85   # une seule note neuve, simple avis : un peu plus large (0,85-0,88 : encore de vraies redites)
DOUBLONS_MIN = 40      # caractères : en dessous, un titre seul (« ## Production ») ressemble à tout


def paires_proches(fichiers: list[str], m, seuil: float) -> dict:
    """{(fichier_a, fichier_b): [(cosinus, i, j), …] du plus proche au moins proche} : passages i et j de deux
    notes différentes dont le cosinus atteint le seuil. m : vecteurs normés, une ligne par passage.
    Par blocs de lignes : la mémoire reste bornée même pour des dizaines de milliers de passages."""
    import numpy as np

    f = np.asarray(fichiers)
    paires = collections.defaultdict(list)
    for debut in range(0, len(fichiers), 1024):
        bloc = m[debut:debut + 1024] @ m.T
        for k, j in zip(*np.nonzero(bloc >= seuil), strict=True):
            i = debut + int(k)
            if i < j and f[i] != f[j]:
                paires[tuple(sorted((fichiers[i], fichiers[j])))].append((float(bloc[k, j]), i, int(j)))
    return {c: sorted(v, reverse=True) for c, v in paires.items()}


def meilleurs_par_note(fichiers: list[str], m, q, seuil: float, n: int = 3) -> list[tuple[str, float, int]]:
    """Notes les plus proches d'un texte : pour chaque note, son passage le plus proche de l'un des vecteurs q
    (cosinus ≥ seuil). [(fichier, cosinus, indice du passage)], du plus proche au moins proche, n au plus."""
    import numpy as np

    cos = (m @ np.asarray(q, dtype=np.float32).T).max(axis=1)
    meilleur: dict[str, tuple[float, int]] = {}
    for i in np.nonzero(cos >= seuil)[0]:
        c = float(cos[i])
        if c > meilleur.get(fichiers[i], (-1.0, 0))[0]:
            meilleur[fichiers[i]] = (c, int(i))
    return sorted(((f, c, i) for f, (c, i) in meilleur.items()), key=lambda t: -t[1])[:n]


def passages_compares(con, base: Path) -> list:
    """Passages qu'on compare pour les doublons : hors archives et MEMORY.md, assez longs, avec vecteur."""
    con.execute("ATTACH DATABASE ? AS c", (f"file:{base_sens(base)}?mode=ro",))
    return [r for r in con.execute(
        "SELECT p.fichier, p.ligne, p.texte, c.v.v FROM passages p JOIN sens s ON s.rowid = p.rowid "
        "JOIN c.v ON c.v.h = s.h WHERE p.type NOT IN ('archive', 'index')")
        if len(r[2]) >= DOUBLONS_MIN and Path(r[0]).name != "MEMORY.md"]


def sens_pret(base: Path, qui: str) -> bool:
    if not sens_actif():
        print(f"{qui} : il faut la recherche par le sens (MEM_SENS, Ollama local)", file=sys.stderr)
        return False
    try:
        import numpy  # noqa: F401
    except ImportError:
        print(f"{qui} : numpy absent", file=sys.stderr)
        return False
    if not base_sens(base).exists():
        print(f"{qui} : aucun vecteur ({raison_sens()})", file=sys.stderr)
        return False
    return True


def notes_voisines(racine: Path, base: Path, q=None, note: str | None = None,
                   seuil: float = DOUBLONS_SEUIL) -> list[tuple[str, float, int, str]] | None:
    """Notes proches d'une note de la mémoire (ses passages indexés) ou de vecteurs q déjà calculés.
    [(fichier, cosinus, ligne, extrait)] ; None si le sens n'est pas disponible."""
    import numpy as np

    assurer_index(racine, base)
    con = sqlite3.connect(f"file:{base}?mode=ro", uri=True)
    try:
        lignes = passages_compares(con, base)
    finally:
        con.close()
    if note is not None:
        q = [np.frombuffer(r[3], dtype=np.float32) for r in lignes if r[0] == note]
        lignes = [r for r in lignes if r[0] != note]
    if q is None or not len(q) or not lignes:
        return [] if q is not None and len(q) else None
    m = np.frombuffer(b"".join(r[3] for r in lignes), dtype=np.float32).reshape(len(lignes), -1)
    return [(f, c, lignes[i][1], " ".join(lignes[i][2].split())[:110])
            for f, c, i in meilleurs_par_note([r[0] for r in lignes], m, q, seuil)]


def voisins(racine: Path, base: Path, cible: str, seuil: float = VOISINS_SEUIL) -> int:
    """Avant de garder une note neuve : les notes qui disent déjà la même chose. Code 1 s'il y en a."""
    note = normaliser_dans(racine, cible)
    if not note or note.endswith("/"):
        print(f"mem voisins : « {cible} » n'est pas une note de {racine}", file=sys.stderr)
        return 2
    if not sens_pret(base, "mem voisins"):
        return 2
    trouves = notes_voisines(racine, base, note=note, seuil=seuil)
    if trouves is None:
        print(f"mem voisins : {note} n'a pas encore de vecteur ({raison_sens()})", file=sys.stderr)
        return 2
    for f, c, ligne, extrait in trouves:
        print(f"{f}:{ligne}  ({c:.2f})  {extrait}")
    return 1 if trouves else 0


def doublons(racine: Path, base: Path, seuil: float = DOUBLONS_SEUIL, n: int = 20, dans: str | None = None) -> int:
    """Notes qui se répètent (ou se contredisent) : paires de passages très proches par le sens, dans deux notes
    différentes, regroupées par paire de notes. Hors archives (elles reprennent les notes par construction) et
    MEMORY.md, à la racine comme dans un sous-dossier (il résume les notes). Ne change rien : c'est à l'agent de fusionner ou de trancher."""
    assurer_index(racine, base)
    if not sens_pret(base, "mem doublons"):
        return 2
    import numpy as np

    con = sqlite3.connect(f"file:{base}?mode=ro", uri=True)
    try:
        lignes = passages_compares(con, base)  # un MEMORY.md de sous-dossier est exclu aussi
        if dans:
            lignes = [r for r in lignes if (r[0].startswith(dans) if dans.endswith("/") else r[0] == dans)]
        clause, args = filtre_dans(dans, "p.fichier")
        total = sum(Path(f).name != "MEMORY.md" for (f,) in con.execute(
            "SELECT p.fichier FROM passages p WHERE p.type NOT IN ('archive', 'index')" + clause, args))
    finally:
        con.close()
    if not lignes:
        print("aucun passage avec vecteur à comparer")
        return 0
    m = np.frombuffer(b"".join(r[3] for r in lignes), dtype=np.float32).reshape(len(lignes), -1)
    paires = paires_proches([r[0] for r in lignes], m, seuil)
    ordre = sorted(paires.items(), key=lambda kv: (-len(kv[1]), -kv[1][0][0]))
    sans = total - len(lignes)
    print(f"{len(paires)} paire(s) de notes proches (seuil {seuil:.2f} ; {len(lignes)} passages comparés"
          + (f", {sans} trop courts ou sans vecteur" if sans else "") + ")")

    def court(texte: str) -> str:
        t = " ".join(texte.split())
        return t if len(t) <= 110 else t[:109] + "…"

    for (fa, fb), liste in ordre[:n]:
        cos, i, j = liste[0]
        if lignes[i][0] != fa:
            i, j = j, i
        print(f"\n{len(liste)} passage(s), jusqu'à {cos:.2f}  {fa}  ↔  {fb}")
        print(f"    {fa}:{lignes[i][1]}  {court(lignes[i][2])}")
        print(f"    {fb}:{lignes[j][1]}  {court(lignes[j][2])}")
    if len(ordre) > n:
        print(f"\n… {len(ordre) - n} autre(s) paire(s) : --n {len(ordre)}")
    if ordre:
        print("\nÀ trancher note par note : fusionner (garder la plus juste), ou corriger celle qui contredit.")
    return 0


# Renvois vérifiables d'une note : chemin local, fichier relatif (au dépôt ou à la mémoire), commit, lien.
RENVOI_CHEMIN = re.compile(r"(?<![\w/.~-])((?:~|" + re.escape(str(Path.home())) + r")/[\w.@+/-]+)")
RENVOI_FICHIER = re.compile(r"(?<![\w/.~-])((?:[\w-][\w.-]*/)+[\w.-]+\.(?:py|sh|md|mjs|js|ts|json|toml|ya?ml|html|css|kt|"
                            r"service|timer|conf|txt|tsv|sql))\b")
RENVOI_COMMIT = re.compile(r"(?<![\w/#.-])([0-9a-f]{7,12})(?![\w/…-])")
# Mots qui, juste avant (40 caractères), disent qu'un hexadécimal n'est pas un commit : empreinte d'un point,
# identifiant de session, somme sha256, exemple.
PAS_UN_COMMIT = re.compile(r"empreinte|session|conversation|projet|sha|uuid|\bex\.|exemple|\bid\b", re.I)
RENVOI_LIEN = re.compile(r"\[\[([^\]|#]+)")
RENVOI_INDEX = re.compile(r"\]\(([^)#\s]+\.md)\)")


def depots_connus(racine: Path, depots: list[Path] | None = None) -> list[Path]:
    """Dépôts git où chercher les commits et les fichiers : ceux donnés, sinon celui du dossier courant et ceux
    qui l'englobent (~/Scripts/Claude autour d'AIMailBox), celui de la mémoire, et ~/.config/mem/depots."""
    if depots:
        candidats = list(depots)
    else:
        candidats = [Path.cwd(), racine]
        try:
            liste = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "mem" / "depots"
            candidats += [Path(l.strip()).expanduser() for l in liste.read_text(encoding="utf-8").splitlines()
                          if l.strip() and not l.startswith("#")]
        except (OSError, ValueError):
            pass
    vus: list[Path] = []
    for d in candidats:
        while d.is_dir():
            r = subprocess.run(["git", "-C", str(d), "rev-parse", "--show-toplevel"], capture_output=True, text=True)
            if r.returncode != 0:
                break
            haut = Path(r.stdout.strip())
            if haut not in vus:
                vus.append(haut)
            if depots or haut.parent == haut:
                break  # dépôts donnés à la main : pas de remontée
            d = haut.parent
    return vus


def renvois_morts(racine: Path, depots: list[Path], dans: str | None = None) -> tuple[dict, list, collections.Counter]:
    """({note: [(ligne, genre, renvoi)]}, [(index, ligne, lien)], {lien [[…]] sans note: nombre}).
    Hors archives : une archive raconte le passé, ses renvois ont le droit d'être morts. Une ligne qui ressemble
    à un secret n'est pas lue."""
    toutes = [p for p in notes(racine) if not str(p.relative_to(racine)).startswith("archive/")]
    if dans:
        toutes = [p for p in toutes if (str(p.relative_to(racine)).startswith(dans) if dans.endswith("/")
                                        else str(p.relative_to(racine)) == dans)]
    noms = {p.stem for p in notes(racine)}
    for p in notes(racine):
        try:
            entete, _ = lire_entete(p.read_text(encoding="utf-8", errors="replace").splitlines())
        except OSError:
            continue
        if entete.get("name"):
            noms.add(entete["name"])
    # Fichiers suivis des dépôts, par toutes leurs fins de chemin : « api/aide.py » trouve app/api/aide.py.
    suivis: set[str] = set()
    for d in depots:
        r = subprocess.run(["git", "-C", str(d), "ls-files", "-z"], capture_output=True, text=True)
        for f in r.stdout.split("\0"):
            morceaux = f.split("/")
            suivis.update("/".join(morceaux[i:]) for i in range(len(morceaux)))
    morts, index_morts, liens = collections.defaultdict(list), [], collections.Counter()
    commits: dict[str, list] = collections.defaultdict(list)
    for p in toutes:
        rel = str(p.relative_to(racine))
        for n, l in enumerate(p.read_text(encoding="utf-8", errors="replace").splitlines(), start=1):
            if motif_secret(l):
                continue
            for m in RENVOI_CHEMIN.finditer(l):
                chemin = m.group(1).rstrip(".,;:")
                if l[m.end():m.end() + 1] in ("<", "{", "*", "$", "…") or "…" in chemin:
                    continue  # gabarit (~/coffre-<date>), pas un fichier
                if not Path(chemin).expanduser().exists():
                    morts[rel].append((n, "chemin", chemin))
            for m in RENVOI_FICHIER.finditer(l):
                f = m.group(1)
                if (l[m.end():m.end() + 1] in ("<", "{", "*") or l[m.start() - 1:m.start()] in ("<", "{", "*")
                        or f.startswith("scratchpad/")  # gabarit, ou brouillon de session (jetable par nature)
                        or l[m.start() - 2:m.start()] == "]("):  # lien d'index : vérifié plus bas, une seule fois
                    continue
                if f not in suivis and not any((base_ / f).exists() for base_ in (racine, p.parent, *depots)):
                    morts[rel].append((n, "fichier", f))
            for m in RENVOI_COMMIT.finditer(l):
                h = m.group(1)
                if (re.search(r"[a-f]", h) and re.search(r"\d", h) and l[m.end():m.end() + 1] != "…"
                        and not PAS_UN_COMMIT.search(l[max(0, m.start() - 40):m.start()])):
                    commits[h].append((rel, n))
            for m in RENVOI_LIEN.finditer(l):
                if m.group(1).strip() not in noms:
                    liens[m.group(1).strip()] += 1
            if p.name == "MEMORY.md":
                for m in RENVOI_INDEX.finditer(l):
                    if not (p.parent / m.group(1)).exists():
                        index_morts.append((rel, n, m.group(1)))
    inconnus = set(commits)
    for d in depots:
        if not inconnus:
            break
        essai = sorted(inconnus)
        r = subprocess.run(["git", "-C", str(d), "cat-file", "--batch-check"], input="".join(h + "\n" for h in essai),
                           capture_output=True, text=True)
        # Une ligne de réponse par question, dans l'ordre : « <sha complet> commit … », « <h> missing », « <h> ambiguous ».
        inconnus -= {h for h, rep_ in zip(essai, r.stdout.splitlines(), strict=False) if not rep_.endswith(" missing")}
    for h in inconnus:
        for rel, n in commits[h]:
            morts[rel].append((n, "commit", h))
    return {k: sorted(set(v)) for k, v in morts.items()}, index_morts, liens


def perimes(racine: Path, depots: list[Path] | None = None, n: int = 30, dans: str | None = None) -> int:
    """Notes qui renvoient à ce qui n'existe plus ici : chemin local, fichier du dépôt ou de la mémoire, commit,
    note de l'index. Code 1 s'il y en a. Ce qui vit ailleurs (VPS, VM, branche non récupérée) sort aussi :
    c'est une liste à vérifier, pas une preuve."""
    depots = depots_connus(racine, depots)
    morts, index_morts, liens = renvois_morts(racine, depots, dans)
    ordre = sorted(morts.items(), key=lambda kv: (-len(kv[1]), kv[0]))
    print(f"{len(morts)} note(s) avec des renvois introuvables ici (hors archives ; dépôts : "
          f"{', '.join(d.name for d in depots) or 'aucun'})")
    detail = 10**6 if dans and not dans.endswith("/") else 5  # une seule note demandée : tout son détail
    for rel, liste in ordre[:n]:
        print(f"\n{rel} : {len(liste)}")
        for ligne, genre, renvoi in liste[:detail]:
            print(f"    :{ligne:<4} {genre:<8} {renvoi}")
        if len(liste) > detail:
            print(f"    … {len(liste) - detail} de plus : --dans {rel}")
    if len(ordre) > n:
        print(f"\n… {len(ordre) - n} autre(s) note(s) : --n {len(ordre)}")
    if index_morts:
        print(f"\nIndex : {len(index_morts)} ligne(s) vers une note absente")
        for rel, ligne, lien in index_morts:
            print(f"    {rel}:{ligne}  {lien}")
    if liens:
        print(f"\nLiens [[…]] sans note ({len(liens)}, des notes à écrire, pas forcément une erreur) : "
              + ", ".join(sorted(liens)))
    if morts or index_morts:
        print("\nPour chaque renvoi : vérifier en direct, puis corriger la note (ou la passer en archive si elle"
              " ne décrit plus que le passé).")
    return 1 if morts or index_morts else 0


POINT_NOTE = os.environ.get("MEM_POINT_NOTE") or "project/point-de-reprise.md"
POINT_ARCHIVE = os.environ.get("MEM_POINT_ARCHIVE") or "archive/point-de-reprise.md"


def point(racine: Path, source: str, note_rel: str = POINT_NOTE, archive_rel: str = POINT_ARCHIVE,
          auteur: str = "", fichier_verrou: Path | None = None) -> int:
    """Remplace le point de reprise : l'ancien (tout ce qui suit l'en-tête, à partir du premier « ## ») part mot
    pour mot à la fin de l'archive, la note ne garde que l'en-tête et le point neuf. verifier-perte contrôle
    qu'aucune ligne n'a disparu ; sinon rien n'est changé. Commit si le dossier mémoire est un dépôt git.
    `auteur` : nom de l'agent (plusieurs agents, une note chacun), repris dans le commit et l'en-tête de l'archive."""
    import contextlib
    import io

    try:
        texte = (sys.stdin.read() if source == "-" else Path(source).read_text(encoding="utf-8")).strip() + "\n"
    except (OSError, UnicodeDecodeError) as e:
        print(f"mem point : lecture impossible de {source} ({e.strerror or e})", file=sys.stderr)
        return 2
    if not texte.startswith("## POINT DE REPRISE"):
        print("mem point : le point doit commencer par « ## POINT DE REPRISE »", file=sys.stderr)
        return 2
    for i, l in enumerate(texte.splitlines(), 1):
        if motif_secret(l) or DEBUT_BLOC.search(l):
            print(f"mem point : refusé, la ligne {i} ressemble à un secret ({motif_secret(l) or 'bloc de clé'})",
                  file=sys.stderr)
            return 2
    note, archive = racine / note_rel, racine / archive_rel

    def couper(contenu: str) -> tuple[str, str]:
        lignes = contenu.splitlines(keepends=True)
        i = next((i for i, l in enumerate(lignes) if l.startswith("## ")), len(lignes))
        return "".join(lignes[:i]), "".join(lignes[i:])

    # Hors du dossier mémoire : rien de non suivi dans son git. Un verrou par dossier, partagé par tous ses agents.
    if fichier_verrou is None:  # à côté de la base de mem (MEM_DB, sinon ~/.local/share/mem/<projet>…)
        fichier_verrou = (Path(os.environ["MEM_DB"]).expanduser().with_suffix(".point.verrou") if os.environ.get("MEM_DB")
                          else _donnees(racine.resolve(), ".point.verrou"))
    fichier_verrou.parent.mkdir(parents=True, exist_ok=True)
    with open(fichier_verrou, "w") as verrou:
        fcntl.flock(verrou, fcntl.LOCK_EX)
        avant_note = note.read_text(encoding="utf-8") if note.exists() else (
            f"---\nname: {Path(note_rel).stem}\ndescription: Dernier point de reprise (écrit avant /clear ou /compact)"
            f"\nmetadata:\n  type: project\n---\n")
        avant_archive = archive.read_text(encoding="utf-8") if archive.exists() else ""
        tete, corps = couper(avant_note)
        nouvelle_archive = avant_archive
        if corps.strip():
            entete = f"# Points de reprise archivés{' de ' + auteur if auteur else ''}\n"
            nouvelle_archive = (nouvelle_archive or entete).rstrip("\n") + "\n\n" + corps
        nouvelle_note = tete.rstrip("\n") + "\n\n" + texte
        with tempfile.TemporaryDirectory(prefix="mem-point-") as tmp:
            avant, apres = Path(tmp, "avant"), Path(tmp, "apres")
            for d, contenus in ((avant, (avant_note, avant_archive)), (apres, (nouvelle_note, nouvelle_archive))):
                for rel, contenu in zip((note_rel, archive_rel), contenus):
                    (d / rel).parent.mkdir(parents=True, exist_ok=True)
                    (d / rel).write_text(contenu, encoding="utf-8")
            sortie = io.StringIO()
            with contextlib.redirect_stdout(sortie):
                perte = verifier_perte(avant, apres)
            if perte:
                print("mem point : verifier-perte refuse, rien n'est changé\n" + sortie.getvalue(), file=sys.stderr)
                return 1
        archive.parent.mkdir(parents=True, exist_ok=True)
        note.parent.mkdir(parents=True, exist_ok=True)
        # Les deux contenus sont écrits à côté, puis mis en place par os.replace : un arrêt ne laisse jamais un
        # fichier à moitié écrit. Seule fenêtre restante : entre les deux replace (archive à jour, note ancienne :
        # l'ancien point en double, rien de perdu).
        tmps = []
        try:
            for cible, contenu in ((archive, nouvelle_archive), (note, nouvelle_note)):
                fd, tmp = tempfile.mkstemp(dir=cible.parent, prefix="." + cible.name + ".", suffix=".tmp")
                tmps.append(tmp)
                with os.fdopen(fd, "w", encoding="utf-8") as f:
                    f.write(contenu)
                    f.flush()
                    os.fsync(f.fileno())
                os.chmod(tmp, cible.stat().st_mode & 0o777 if cible.exists() else 0o644)
            os.replace(tmps[0], archive)
            os.replace(tmps[1], note)
        finally:
            for tmp in tmps:
                if os.path.exists(tmp):
                    os.unlink(tmp)
        commit = ""
        if (racine / ".git").exists():
            subprocess.run(["git", "-C", str(racine), "add", str(note), str(archive)], check=False)
            # « -- note archive » : le commit n'emporte que ces deux fichiers, jamais ce qui était déjà indexé.
            r = subprocess.run(["git", "-C", str(racine), "commit", "-q", "-m",
                                f"{auteur or 'mem point'} : point de reprise archivé, point neuf", "--", str(note), str(archive)],
                               capture_output=True, text=True)
            if r.returncode == 0:
                commit = subprocess.run(["git", "-C", str(racine), "rev-parse", "--short", "HEAD"],
                                        capture_output=True, text=True).stdout.strip()
    ancien = f"ancien point archivé dans {archive_rel} ({len(corps)} octets)" if corps.strip() else "premier point"
    print(f"point de reprise : {note_rel} ({len(nouvelle_note)} octets) ; {ancien} ; aucune ligne perdue"
          + (f" ; commit {commit}" if commit else ""))
    # Avis, jamais un refus : le point neuf renvoie-t-il à ce qui n'existe plus ici (chemin, fichier, commit) ?
    try:
        morts = renvois_morts(racine, depots_connus(racine), dans=note_rel)[0].get(note_rel, [])
    except (OSError, ValueError, subprocess.SubprocessError):
        morts = []
    if morts:
        print(f"à vérifier : {len(morts)} renvoi(s) du point introuvable(s) ici (VPS, VM ou autre dépôt : normal ;"
              " sinon corriger la note) :")
        for ligne, genre, renvoi in morts:
            print(f"    {note_rel}:{ligne}  {genre:<8} {renvoi}")
    return 0

def bench(racine: Path, base: Path, fichier: Path, n: int = 10) -> int:
    """Rejoue des questions de référence : rang de la première note attendue, puis top 1, top 3 et MRR.
    On compare des notes, pas des lignes : une note qui grandit ne casse pas le jeu de questions."""
    questions = []
    try:
        texte = fichier.read_text(encoding="utf-8")
    except (OSError, ValueError) as e:  # absent, illisible, pas en UTF-8 : message et code 2, comme mem point
        print(f"mem bench : lecture impossible de {fichier} ({getattr(e, 'strerror', None) or e})", file=sys.stderr)
        return 2
    for l in texte.splitlines():
        if l.strip() and not l.startswith("#"):
            q, _, attendues = l.partition("\t")
            questions.append((q.strip(), {a.strip() for a in attendues.split(",") if a.strip()}))
    if not questions:
        raise SystemExit(f"mem : aucune question dans {fichier}")
    absentes = sorted({a for _, att in questions for a in att if not (racine / a).is_file()})
    for a in absentes:
        print(f"note attendue introuvable : {a}")
    rangs = []
    for q, attendues in questions:
        fichiers = [r[0] for r in chercher(racine, base, q, n)]
        rang = next((i for i, f in enumerate(fichiers, start=1) if f in attendues), None)
        rangs.append(rang)
        print(f"{rang or '-':>2}  {q}" + ("" if rang and rang <= 3 else f"   (en tête : {fichiers[0] if fichiers else 'rien'})"))
    nb = len(rangs)
    top1 = sum(r == 1 for r in rangs)
    top3 = sum(bool(r and r <= 3) for r in rangs)
    mrr = sum(1 / r for r in rangs if r) / nb
    print(f"\n{nb} questions : top 1 {top1}/{nb}, top 3 {top3}/{nb}, MRR {mrr:.2f}")
    return 2 if absentes else 0  # 2 : jeu de questions à mettre à jour (le score, lui, est valable)


