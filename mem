def slug(titre: str) -> str:
    import unicodedata

    s = unicodedata.normalize("NFKD", titre).encode("ascii", "ignore").decode().lower()
    return re.sub(r"[^a-z0-9]+", "-", s).strip("-")[:60] or "note"


def ajouter(racine: Path, type_: str, titre: str, texte: str, base: Path | None = None, quand_meme: bool = False) -> Path:
    titre = titre.strip()
    if not titre or "\n" in titre or "\r" in titre:
        raise SystemExit("mem : le titre tient sur une seule ligne, non vide")
    for l in [titre, *texte.splitlines()]:
        if motif_secret(l) or DEBUT_BLOC.search(l):
            raise SystemExit(f"mem : refusé, une ligne ressemble à un secret ({motif_secret(l) or 'bloc de clé'})")
    if base is not None and not quand_meme and sens_actif():
        # Une note qui redit une note existante : refusée, l'agent complète plutôt celle-là (--quand-meme sinon).
        morceaux = [m.strip() for m in re.split(r"\n\s*\n", texte) if len(m.strip()) >= DOUBLONS_MIN][:SENS_LOT]
        q = vecteurs([f"{titre}\n{m}"[:2000] for m in morceaux] or [titre], delai=20)
        trouves = notes_voisines(racine, base, q=q, seuil=VOISINS_SEUIL) if q else None
        if trouves:
            raise SystemExit("mem ajouter : refusé, des notes disent déjà presque la même chose :\n"
                             + "\n".join(f"  {f}:{l}  ({c:.2f})  {x}" for f, c, l, x in trouves)
                             + "\nCompléter l'une d'elles ; ou, si le sujet est vraiment autre, relancer avec --quand-meme.")
    dossier = racine / type_
    dossier.mkdir(parents=True, exist_ok=True)
    chemin = dossier / f"{slug(titre)}.md"
    auteur = os.environ.get("AGENT_NOM", "")
    contenu = (f"---\nname: {slug(titre)}\ndescription: {titre}\nauteur: {auteur}\nmodified: {dt.date.today()}\n"
               f"metadata:\n  type: {type_}\n---\n\n{texte.strip()}\n")
    for essai in (chemin, dossier / f"{slug(titre)}-{dt.date.today():%Y%m%d}.md"):
        try:
            with open(essai, "x", encoding="utf-8") as f:  # « x » : jamais d'écrasement, même entre deux ajouts simultanés
                f.write(contenu)
            return essai
        except FileExistsError:
            continue
    raise SystemExit(f"mem : {chemin} existe déjà (et sa variante datée)")


