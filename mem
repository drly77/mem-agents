def langue() -> str:
    """« fr » ou « en » : MEM_LANG, sinon la locale (LC_ALL, LC_MESSAGES, LANG) ; anglais par défaut."""
    choix = os.environ.get("MEM_LANG", "").strip().lower()[:2]
    if choix in ("fr", "en"):
        return choix
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        if os.environ.get(var):
            return "fr" if os.environ[var].lower().startswith("fr") else "en"
    return "en"


def tr(fr: str, en: str) -> str:
    """Le message dans la langue de l'utilisateur ; les deux textes restent côte à côte dans le code."""
    return fr if langue() == "fr" else en


