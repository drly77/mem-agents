    r.add_argument(*deux_noms("--indexer", "--index"), dest="indexer", action="store_true",
                   help=tr("ajouter les nouveaux messages (le sens peut être long la 1re fois)",
                           "add new messages (embeddings can take a while the first time)"))
    r.add_argument(*deux_noms("--sans-sens", "--no-embeddings"), dest="sans_sens", action="store_true",
                   help=argparse.SUPPRESS)
    r.add_argument(*deux_noms("--etat", "--status"), dest="etat", action="store_true",
                   help=tr("base, passages, lignes retirées", "database, passages, withheld lines"))
    co = sub.add_parser("code", help=tr("chercher dans le code du dépôt git courant (fonctions, classes, YAML)",
                                        "search the code of the current git repository (functions, classes, YAML)"))
    co.add_argument("mots", nargs="*", metavar=tr("mots", "words"))
    co.add_argument("--n", type=int, default=5, help=tr("nombre de résultats", "number of results"))
    co.add_argument(*deux_noms("--depot", "--repo"), dest="depot", metavar=tr("DEPOT", "REPO"), type=Path,
                    help=tr("dépôt où chercher (sinon celui du dossier courant)", "repository to search (default: the current one)"))
    co.add_argument(*deux_noms("--dans", "--in"), dest="dans", metavar=tr("DANS", "PATH"),
                    help=tr("seulement ce sous-dossier (app/) ou ce fichier", "only this subfolder (app/) or this file"))
    co.add_argument(*deux_noms("--vite", "--fast"), dest="vite", action="store_true",
                    help=tr("sans reclassement par le modèle local (~1 s au lieu de ~7 s)",
                            "no reranking by the local model (~1 s instead of ~7 s)"))
    co.add_argument(*deux_noms("--indexer", "--index"), dest="indexer", action="store_true",
                    help=tr("refaire l'index du code (la 1re fois, le sens peut prendre plusieurs minutes)",
                            "rebuild the code index (the first time, embeddings can take several minutes)"))
    co.add_argument("--bench", type=Path, metavar=tr("QUESTIONS", "QUESTIONS"),
                    help=tr("top 1, top 3, MRR : une ligne « question<TAB>fichier,fichier »",
                            "top 1, top 3, MRR: one line \"question<TAB>file,file\""))
    args = ap.parse_args(argv)
    args.cmd = COMMANDES_EN.get(args.cmd, args.cmd)  # « mem search » = « mem chercher »
    if args.cmd == "code":
        return code(args)
    if args.cmd == "retrouver":
        return retrouver(args)

    if args.cmd == "selftest":
        return selftest()
    if args.cmd == "verifier-perte":
        return verifier_perte(args.avant, args.apres)
    racine = args.dossier or dossier_par_defaut()
    if racine is None or not racine.expanduser().is_dir():
        print(tr(f"mem : aucun dossier mémoire trouvé depuis {Path.cwd()} ; donner --dossier ou MEM_DIR",
                 f"mem: no memory folder found from {Path.cwd()}; pass --dir or MEM_DIR"), file=sys.stderr)
        return 2
    racine = racine.expanduser()
    base = base_par_defaut(racine)
    if args.cmd == "chercher":
        args.mots = " ".join(args.mots)
        auteur = None if args.tous else (os.environ.get("AGENT_NOM") or None)
        dans = None
        if args.dans is not None:
            dans = normaliser_dans(racine, args.dans)
            if dans is None:
                sous = sorted(d.name + "/" for d in racine.iterdir() if d.is_dir() and not d.name.startswith("."))
                liste_sous = ", ".join(sous)
                print(tr(f"mem : « {args.dans} » n'existe pas dans {racine} (dossiers : {liste_sous or 'aucun'})",
                         f"mem: \"{args.dans}\" does not exist in {racine} (folders: {liste_sous or 'none'})"), file=sys.stderr)
                return 2
        print(tr(f"(mémoire : {racine}" + (f", dans {dans}" if dans else "") + ")",
                 f"(memory: {racine}" + (f", in {dans}" if dans else "") + ")"), file=sys.stderr)
        afficher(chercher(racine, base, args.mots, args.n, args.type, args.depuis, args.archives, auteur,
                          reclasse=not args.vite, dans=dans))
        if args.tous:
            liste = Path.home() / ".config" / "mem" / "dossiers"
            try:
                autres = [l.strip() for l in liste.read_text(encoding="utf-8").splitlines() if l.strip()]
            except FileNotFoundError:
                autres = []
            except (OSError, ValueError) as e:
                print(tr(f"mem : {liste} illisible ({type(e).__name__}), --tous limité à ce dossier",
                         f"mem: {liste} unreadable ({type(e).__name__}), --all limited to this folder"), file=sys.stderr)
                autres = []
            for autre in autres:
                autre = Path(autre).expanduser()
                if autre.is_dir() and autre.resolve() != racine.resolve():
                    print(f"── {autre}", file=sys.stderr)  # stdout : les résultats seulement
                    afficher(chercher(autre, base_par_defaut(autre), args.mots, args.n, args.type, args.depuis, args.archives,
                                      reclasse=not args.vite, dans=dans))
    elif args.cmd == "voir":
        return voir(racine, base, args.cible)
    elif args.cmd == "ajouter":
        print(ajouter(racine, args.type, args.titre, sys.stdin.read(), base, args.quand_meme))
    elif args.cmd == "voisins":
        return voisins(racine, base, args.note, args.seuil)
    elif args.cmd == "indexer":
        total, refus = indexer(racine, base)
        print(tr(f"{total} passages indexés, {refus} lignes refusées", f"{total} passages indexed, {refus} lines refused"))
    elif args.cmd == "etat":
        etat(racine, base)
    elif args.cmd == "perimes":
        dans = None
        if args.dans is not None:
            dans = normaliser_dans(racine, args.dans)
            if dans is None:
                print(tr(f"mem : « {args.dans} » n'existe pas dans {racine}",
                         f"mem: \"{args.dans}\" does not exist in {racine}"), file=sys.stderr)
                return 2
        return perimes(racine, [d.expanduser() for d in args.depot] if args.depot else None, args.n, dans)
    elif args.cmd == "doublons":
        dans = None
        if args.dans is not None:
            dans = normaliser_dans(racine, args.dans)
            if dans is None:
                print(tr(f"mem : « {args.dans} » n'existe pas dans {racine}",
                         f"mem: \"{args.dans}\" does not exist in {racine}"), file=sys.stderr)
                return 2
        return doublons(racine, base, args.seuil, args.n, dans)
    elif args.cmd == "point":
        return point(racine, args.fichier, args.note, args.archive, args.auteur)
    elif args.cmd == "bench":
        return bench(racine, base, args.questions, args.n)
    return 0


if __name__ == "__main__":
    sys.exit(main())
