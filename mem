# Une clé base64 de 44 caractères (WireGuard) n'est gardée que si la ligne dit qu'elle est publique.
CLE_44 = re.compile(r"(?<![A-Za-z0-9+/])[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=?(?![A-Za-z0-9+/=])")
# Toute autre suite base64 de 40 caractères ou plus, mêlant majuscules, minuscules et chiffres : même règle.
CLE_B64 = re.compile(
    r"(?<![A-Za-z0-9+/=_-])(?=[A-Za-z0-9+/]*[A-Z])(?=[A-Za-z0-9+/]*[a-z])(?=[A-Za-z0-9+/]*\d)"
    r"[A-Za-z0-9+/]{40,}={0,2}(?![A-Za-z0-9+/=_-])")
PUBLIQUE = re.compile(r"\b(public|publique|pubkey|PublicKey)\b", re.I)
PRIVEE = re.compile(r"priv|secr|\b(pas|non|not|ni|jamais)\b\W+(\w+\W+){0,2}(public|publique|pubkey)", re.I)
# Un hex de 64 caractères n'est gardé que si la ligne dit que c'est une empreinte.
HEX_64 = re.compile(r"(?<![0-9a-fA-F])[0-9a-fA-F]{64}(?![0-9a-fA-F])")
EMPREINTE = re.compile(r"sha-?256|empreinte|digest|fingerprint", re.I)
DEBUT_BLOC = re.compile(r"-----BEGIN [A-Z0-9 _-]*(PRIVATE KEY|OPENSSH)")
FIN_BLOC = re.compile(r"-----END ")
DANS_BLOC = re.compile(r"[A-Za-z0-9+/=\s]*|\s*(Proc-Type|DEK-Info|Comment):.*")  # sinon le bloc n'a pas de fin

# Idée de generic-api-key (gitleaks) : une valeur de variable qui a l'air tirée au hasard (entropie de Shannon
# > 3,5 bits par caractère). Nom de clé (KEY_ID=, api:) : 10 caractères dont un chiffre suffisent ; tout autre
# VARIABLE= (OPENAI=…) : 12 caractères mêlant majuscules, minuscules et chiffres.
GENERIQUE = re.compile(
    r"\b(?:(?P<cle>[A-Za-z0-9_]*(?:KEY|TOKEN|SECRET|PASS|AUTH|CRED|API)[A-Za-z0-9_]*)\s*[=:]|[A-Za-z_][A-Za-z0-9_]*=)"
    r"\s*[\"']?(?P<v>[A-Za-z0-9+/_.=-]{10,})", re.I)


def entropie(valeur: str) -> float:
    return -sum(n / len(valeur) * math.log2(n / len(valeur)) for n in collections.Counter(valeur).values())


def aleatoire(m: re.Match) -> bool:
    v = m.group("v")
    if not m.group("cle") and (len(v) < 12 or not (re.search(r"[A-Z]", v) and re.search(r"[a-z]", v))):
        return False
    return any(c.isdigit() for c in v) and entropie(v) > 3.5


