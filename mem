def motif_lisible(motif: str) -> str:
    if langue() == "fr":
        return motif
    suffixe = " (value masked)" if motif.endswith(MASQUEE) else ""
    motif = motif.removesuffix(MASQUEE)
    return MOTIFS_EN.get(motif, motif) + suffixe


def genre_lisible(genre: str) -> str:
    return genre if langue() == "fr" else GENRES_EN.get(genre, genre)


def motif_secret(ligne: str) -> str | None:
    for nom, motif in SECRETS:
        if motif.search(ligne):
            return nom
    if (CLE_44.search(ligne) or CLE_B64.search(ligne)) and (not PUBLIQUE.search(ligne) or PRIVEE.search(ligne)):
        return "clé base64"
    if HEX_64.search(ligne) and (not EMPREINTE.search(ligne) or PRIVEE.search(ligne)):
        return "hex 64"
    publique = PUBLIQUE.search(ligne) and not PRIVEE.search(ligne)  # « PublicKey = … » : même règle que CLE_44
    if not publique and any(aleatoire(m) for m in GENERIQUE.finditer(ligne)):
        return "valeur aléatoire"
    return None


def masquer_motif(rx: re.Pattern, ligne: str, garde=None) -> str:
    # Le masque part de la valeur (groupe v) ou du motif entier, et va jusqu'au blanc suivant :
    # « Abc12345<Zz9876qq » ne laisse rien derrière le « < ».
    morceaux, pos = [], 0
    for m in rx.finditer(ligne):
        if garde and not garde(m):
            continue
        debut = m.start("v") if "v" in rx.groupindex else m.start()
        if debut < pos:
            continue
        morceaux += [ligne[pos:debut], MASQUE]
        pos = re.compile(r"\S*").match(ligne, m.end()).end()
    return "".join(morceaux) + ligne[pos:]


def masquer(ligne: str) -> tuple[str | None, str | None]:
    """(ligne à indexer, motif) : la valeur suspecte devient [masqué] et la règle autour reste trouvable ;
    None si la ligne doit être retirée en entier (clé privée, ou toujours suspecte après masquage)."""
    motif = motif_secret(ligne)
    if not motif:
        return ligne, None
    if motif in RETIRER:
        return None, motif
    for _ in range(4):  # un masquage peut faire apparaître une autre « valeur » plus loin sur la ligne
        for rx in [rx for _, rx in SECRETS] + [CLE_44, CLE_B64, HEX_64]:
            ligne = masquer_motif(rx, ligne)
        ligne = masquer_motif(GENERIQUE, ligne, aleatoire)
        if not motif_secret(ligne):
            return ligne, motif
    return None, motif


def lire_entete(lignes: list[str]) -> tuple[dict, int]:
    """Frontmatter YAML simple (clé: valeur, une ligne) ; renvoie (champs, première ligne du corps)."""
    if not lignes or lignes[0].strip() != "---":
        return {}, 0
    champs = {}
    for i, l in enumerate(lignes[1:], start=1):
        if l.strip() == "---":
            return champs, i + 1
        m = re.match(r"\s*([A-Za-z_]+):\s*(.*)$", l)
        if m and m.group(2):
            champs.setdefault(m.group(1), m.group(2).strip().strip('"'))
    return {}, 0


def date_du_passage(texte: str, modifie: str) -> str | None:
    # Date d'écriture en tête d'entrée (« - 08/11 … », « ## 2026-11-08 »), jamais une date citée plus loin.
    tete = TETE.sub("", texte[:60], count=1)[:12]
    m = DATE_ISO.match(tete)
    if m:
        return "-".join(m.groups())
    m = DATE_FR.match(tete)
    if m:
        j, mo, a = int(m.group(1)), int(m.group(2)), m.group(3) or modifie[:4]
        try:
            d = dt.date(int(a), mo, j)
        except ValueError:
            return None
        # Plus de deux mois après la dernière écriture du fichier : c'est l'an passé (un rappel « 19/11 » écrit le 12/11 reste à venir).
        if not m.group(3) and d > dt.date.fromisoformat(modifie[:10]) + dt.timedelta(days=60):
            try:
                d = d.replace(year=d.year - 1)
            except ValueError:  # 29/02
                return None
        return d.isoformat()
    return None


def decouper(chemin: Path, racine: Path):
    """Passages d'une note : coupés par titre (#) ou entrée de liste de premier niveau."""
    lignes = chemin.read_text(encoding="utf-8", errors="replace").splitlines()
    entete, debut = lire_entete(lignes)
    rel = str(chemin.relative_to(racine))
    refus = []
    # L'en-tête passe par le même filtre que le corps : un champ suspect est retiré, quel qu'il soit.
    for n, l in enumerate(lignes[:debut], start=1):
        motif = motif_secret(l)
        if motif:
            refus.append((rel, n, motif))
            m = re.match(r"\s*([A-Za-z_]+):", l)
            if m:
                entete.pop(m.group(1), None)
    type_ = entete.get("type") or (rel.split("/")[0] if "/" in rel else "index")
    if rel.startswith("archive/"):
        type_ = "archive"
    modifie = entete.get("modified", "")[:10] or dt.date.fromtimestamp(chemin.stat().st_mtime).isoformat()
    # Repère de l'année d'une date sans année : la dernière écriture réelle (le « modified: » d'en-tête retarde souvent).
    reference = max(modifie, dt.date.fromtimestamp(chemin.stat().st_mtime).isoformat())
    nom = entete.get("name") or chemin.stem
    auteur = entete.get("auteur", "")
    passages = []
    courant, ligne0 = [], debut + 1
    section = {"date": None, "titre": ""}  # dernier titre : sa date vaut pour les entrées non datées qui suivent

    def clore():
        texte = "\n".join(courant).strip()
        if not texte:
            return
        date = date_du_passage(texte, reference)
        if texte.startswith("#"):
            section["titre"] = texte.splitlines()[0].lstrip("# ").strip()[:120]
            if date:
                section["date"] = date
        elif date and ("POINT DE REPRISE" in texte[:40].upper() or date > (section["date"] or "")):
            section["date"] = date  # une entrée non datée suit la dernière entrée datée de sa section
        titre = lisible(nom) + (" / " + section["titre"] if section["titre"] and not texte.startswith("#") else "")
        passages.append((rel, ligne0, date or section["date"] or modifie, type_, auteur, titre, texte))

    if entete.get("description"):
        passages.append((rel, 1, modifie, type_, auteur, lisible(nom), entete["description"]))
    dans_bloc = False
    for n, l in enumerate(lignes[debut:], start=debut + 1):
        if DEBUT_BLOC.search(l):
            dans_bloc = True
        if dans_bloc and not (DEBUT_BLOC.search(l) or FIN_BLOC.search(l) or DANS_BLOC.fullmatch(l)):
            refus.append((rel, n, "bloc de clé sans END : fermé avant cette ligne"))
            dans_bloc = False
        if dans_bloc:
            refus.append((rel, n, "bloc de clé"))
            if FIN_BLOC.search(l):
                dans_bloc = False
            continue
        texte, motif = masquer(l)
        if motif:
            refus.append((rel, n, motif + (MASQUEE if texte is not None else "")))
            if texte is None:
                continue
            l = texte
        nouveau = l.startswith("#") or l.startswith("- ") or (l.strip() == "" and sum(map(len, courant)) > TAILLE_MAX)
        if nouveau and courant:
            clore()
            courant = []
        if not courant:
            ligne0 = n
        if l.strip() or courant:
            courant.append(l)
    clore()
    return passages, refus


def lisible(nom: str) -> str:
    # « tache49-bout-en-bout » → « tache 49 bout en bout » : le titre se cherche aussi par « 49 ».
    return re.sub(r"(?<=[^\W\d_])(?=\d)", " ", nom.replace("-", " "))


def sens_actif() -> bool:
    if os.environ.get("MEM_SENS", "1") == "0":
        return False
    return urllib.parse.urlparse(SENS_URL).hostname in ("127.0.0.1", "localhost", "::1")


def raison_sens() -> str:
    """Pourquoi le sens manque : Ollama injoignable ou modèle absent."""
    import json
    u = urllib.parse.urlparse(SENS_URL)
    base = f"{u.scheme}://{u.netloc}"
    try:
        direct = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # jamais par un proxy
        with direct.open(base + "/api/tags", timeout=3) as r:
            modeles = [m.get("name", "") for m in json.load(r).get("models", [])]
    except (OSError, ValueError):  # réseau, délai, URL mal formée (InvalidURL), JSON illisible ; un bogue d'ici
        # plante bruyamment au lieu d'un faux diagnostic
        return tr(f"Ollama injoignable ou adresse invalide ({base}) : vérifier MEM_SENS_URL, démarrer Ollama",
                  f"Ollama unreachable or invalid address ({base}): check MEM_SENS_URL, start Ollama")
    if not any(m.split(":")[0] == SENS_MODELE.split(":")[0] for m in modeles):
        return tr(f"modèle {SENS_MODELE} absent : « ollama pull {SENS_MODELE} »",
                  f"model {SENS_MODELE} missing: \"ollama pull {SENS_MODELE}\"")
    return tr("Ollama répond : le calcul a sans doute été interrompu",
              "Ollama answers: the computation was probably interrupted")


_AVIS_NUMPY = []  # l'avis « numpy absent » n'est donné qu'une fois par commande


def vecteurs(textes: list[str], delai: float = SENS_DELAI) -> list | None:
    """Vecteurs normalisés (float32) ; None si Ollama ne répond pas ou si numpy manque (avec un avis)."""
    try:
        import numpy as np
    except ImportError:  # par exemple python3 -I, qui cache les modules installés par pip --user
        if not _AVIS_NUMPY:
            _AVIS_NUMPY.append(1)
            print(tr("mem : numpy absent, recherche par le sens coupée (pip install numpy)",
                     "mem: numpy missing, search by meaning is off (pip install numpy)"), file=sys.stderr)
        return None
    try:
        # keep_alive -1 : bge-m3 reste chargé (sinon Ollama le décharge après 5 min et la recherche suivante
        # perd 3 à 4 s). MEM_SENS_GARDER=0 revient au délai d'Ollama.
        corps = {"model": SENS_MODELE, "input": textes}
        if os.environ.get("MEM_SENS_GARDER", "1") != "0":
            corps["keep_alive"] = -1
        corps = json.dumps(corps).encode()
        req = urllib.request.Request(SENS_URL, corps, {"Content-Type": "application/json"})
        # Jamais par un proxy : http_proxy ne contourne pas 127.0.0.1 de lui-même.
        direct = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with direct.open(req, timeout=delai) as r:
            m = np.asarray(json.load(r)["embeddings"], dtype=np.float32)
        return list(m / np.maximum(np.linalg.norm(m, axis=1, keepdims=True), 1e-9))
    except Exception:  # réseau, modèle absent : on reste sur les mots
        return None


def base_sens(base: Path) -> Path:
    # « x.db » -> « x.sens.db » (nom historique) ; tout autre nom garde le sien entier : x.sqlite -> x.sqlite.sens.db
    return base.with_suffix(".sens.db") if base.suffix == ".db" else base.with_name(base.name + ".sens.db")  # cache des vecteurs, par empreinte du passage : survit aux réindexations


def calculer_sens(con: sqlite3.Connection, base: Path) -> None:
    """Associe à chaque passage le vecteur de son texte (masqué) ; ne calcule que les textes nouveaux."""
    con.execute("CREATE TABLE sens(rowid INTEGER PRIMARY KEY, h TEXT)")
    if not sens_actif():
        return
    lignes = con.execute("SELECT rowid, titre, texte FROM passages").fetchall()
    cles = {r[0]: hashlib.sha256(f"{SENS_MODELE}\0{r[1]}\0{r[2]}".encode()).hexdigest() for r in lignes}
    os.close(os.open(base_sens(base), os.O_CREAT | os.O_WRONLY, 0o600))  # créé 0600 d'emblée, jamais avec l'umask
    cache = sqlite3.connect(base_sens(base))
    try:
        os.chmod(base_sens(base), 0o600)
        cache.execute("CREATE TABLE IF NOT EXISTS v(h TEXT PRIMARY KEY, v BLOB)")
        connus = {h for (h,) in cache.execute("SELECT h FROM v")}
        a_faire = [r for r in lignes if cles[r[0]] not in connus]
        for i in range(0, len(a_faire), SENS_LOT):
            lot = a_faire[i:i + SENS_LOT]
            if sys.stderr.isatty() and len(a_faire) > SENS_LOT:
                print(tr(f"\rmem : sens, {i}/{len(a_faire)} passages…", f"\rmem: embeddings, {i}/{len(a_faire)} passages…"),
                      end="", file=sys.stderr, flush=True)
            vs = vecteurs([f"{t}\n{x}"[:2000] for _, t, x in lot])
            if vs is None:
                break  # Ollama absent : les passages restants seront faits à la prochaine réindexation
            cache.executemany("INSERT OR REPLACE INTO v VALUES (?, ?)",
                              [(cles[r[0]], v.tobytes()) for r, v in zip(lot, vs)])
            cache.commit()
        if sys.stderr.isatty() and len(a_faire) > SENS_LOT:
            print("\r\033[K", end="", file=sys.stderr, flush=True)
        presents = {h for (h,) in cache.execute("SELECT h FROM v")}
        cache.executemany("DELETE FROM v WHERE h = ?", [(h,) for h in presents - set(cles.values())])
        cache.commit()
        con.executemany("INSERT INTO sens VALUES (?, ?)", [(i, h) for i, h in cles.items() if h in presents])
    finally:
        cache.close()


def notes(racine: Path):
    if MODE_CODE:
        return fichiers_code(racine)
    return sorted(p for p in racine.rglob("*.md") if p.is_file() and not any(part.startswith(".") for part in p.relative_to(racine).parts))


# mem code : chercher dans le code d'un dépôt, avec les mêmes index, fusion et reclasseur que pour les notes.
MODE_CODE = False  # vrai pour « mem code » : fichiers de code au lieu des notes .md
EXT_CODE = {".py", ".yaml", ".yml", ".sh", ".js", ".ts", ".toml"}  # $MEM_CODE_EXT (« .py,.sh ») les remplace
CODE_TAILLE_FICHIER = 500_000  # octets : au-delà (données, fichier minifié), le fichier n'est pas indexé
CODE_LIGNES = 60  # une fonction plus longue est recoupée en morceaux de CODE_LIGNES lignes
# Banc de code (40 questions sur une application FastAPI, 22/11/2026) : renoter 20 passages coupés à 600 caractères
# fait aussi bien que 20 passages entiers (MRR 0,91) en deux fois moins de temps (~7 s).
K_RECLASSE_CODE, LONGUEUR_RECLASSE_CODE = 20, 600
CODE_REGROUPE = int(os.environ.get("MEM_CODE_REGROUPE", "1500"))  # caractères : taille visée des passages regroupés
IGNORES_CODE = {"node_modules", "__pycache__", "venv", ".venv", "dist", "build"}


def depot_courant() -> Path | None:
    try:
        r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=30, check=True)
    except (OSError, subprocess.SubprocessError):
        return None
    return Path(r.stdout.strip()) if r.stdout.strip() else None


def fichiers_code(racine: Path) -> list[Path]:
    """Les fichiers suivis par git (jamais .env, données ni journaux non suivis) ; hors dépôt git, l'arborescence
    sans dossiers cachés ni dépendances. Ni lien symbolique (il pourrait sortir du dépôt) ni très gros fichier."""
    exts = {e.strip().lower() for e in os.environ.get("MEM_CODE_EXT", "").split(",") if e.strip()} or EXT_CODE
    try:
        sortie = subprocess.run(["git", "-C", str(racine), "ls-files", "-z"], capture_output=True, timeout=60,
                                check=True).stdout
        chemins = [racine / n for n in sortie.decode("utf-8", "replace").split("\0") if n]
    except (OSError, subprocess.SubprocessError):
        chemins = [p for p in racine.rglob("*") if not any(x.startswith(".") or x in IGNORES_CODE
                                                           for x in p.relative_to(racine).parts)]
    return sorted(p for p in chemins if p.suffix.lower() in exts and not p.is_symlink() and p.is_file()
                  and p.stat().st_size <= CODE_TAILLE_FICHIER)


def morceaux_python(texte: str, nb: int) -> list[tuple[int, int, str]]:
    """(début, fin, nom) : chaque fonction, classe et méthode, décorateurs compris ; le code entre elles (imports,
    constantes, en-tête de classe) forme ses propres morceaux. Lève SyntaxError si le fichier ne se lit pas."""
    morceaux = []

    def debut(nd):
        return min([nd.lineno] + [d.lineno for d in getattr(nd, "decorator_list", [])])

    def visiter(corps, prefixe: str, de: int, a: int):
        curseur = de
        for nd in corps:
            if not isinstance(nd, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                continue
            d, f = debut(nd), nd.end_lineno
            if d > curseur:
                morceaux.append((curseur, d - 1, prefixe.rstrip(".") or "(module)"))
            nom = prefixe + nd.name
            if isinstance(nd, ast.ClassDef) and any(isinstance(m, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))
                                                    for m in nd.body):
                visiter(nd.body, nom + ".", d, f)  # l'en-tête de la classe devient le morceau qui précède ses méthodes
            else:
                morceaux.append((d, f, nom))
            curseur = f + 1
        if curseur <= a:
            morceaux.append((curseur, a, prefixe.rstrip(".") or "(module)"))

    visiter(ast.parse(texte).body, "", 1, nb)
    return morceaux


def morceaux_blocs(lignes: list[str], yaml: bool) -> list[tuple[int, int, str]]:
    """YAML : un morceau par clé de premier niveau (regroupées jusqu'à 15 lignes) ; autres : coupé aux lignes vides."""
    def frontiere(l: str) -> bool:
        return bool(l) and not l[0].isspace() and l[0] not in "#-" if yaml else not l.strip()

    morceaux, debut = [], 1
    for n in range(2, len(lignes) + 1):
        if (frontiere(lignes[n - 1]) and n - debut >= 15) or n - debut >= CODE_LIGNES:
            morceaux.append((debut, n - 1, ""))
            debut = n
    if lignes:
        morceaux.append((debut, len(lignes), ""))
    return morceaux


def decouper_code(chemin: Path, racine: Path):
    """Passages d'un fichier de code : même filtre des secrets que les notes, ligne par ligne, puis découpe."""
    rel = str(chemin.relative_to(racine))
    brut = chemin.read_text(encoding="utf-8", errors="replace")
    lignes, propres, refus, dans_bloc = brut.splitlines(), [], [], False
    for n, l in enumerate(lignes, start=1):
        if DEBUT_BLOC.search(l):
            dans_bloc = True
        if dans_bloc:
            refus.append((rel, n, "bloc de clé"))
            if FIN_BLOC.search(l):
                dans_bloc = False
            propres.append("")  # la ligne disparaît, les numéros restent justes
            continue
        texte, motif = masquer(l)
        if motif:
            refus.append((rel, n, motif + (MASQUEE if texte is not None else "")))
            l = texte if texte is not None else ""
        propres.append(l)
    morceaux = None
    if chemin.suffix.lower() == ".py":
        try:
            morceaux = morceaux_python(brut, len(lignes))
        except (SyntaxError, ValueError, RecursionError):
            pass  # fichier Python illisible : découpé comme un texte
    if morceaux is None:
        morceaux = morceaux_blocs(propres, chemin.suffix.lower() in (".yaml", ".yml"))
    passages = []
    for d, f, nom in morceaux:
        for d2 in range(d, f + 1, CODE_LIGNES):
            bloc = propres[d2 - 1:min(f, d2 + CODE_LIGNES - 1)]
            texte = "\n".join(bloc).strip("\n")
            if not texte.strip():
                continue
            if not nom:  # YAML ou texte : la première ligne non vide sert de nom
                nom_bloc = next((x.strip() for x in bloc if x.strip()), "")[:60]
            else:
                nom_bloc = nom
            d_reel = d2 + next(i for i, x in enumerate(bloc) if x.strip())
            passages.append((rel, d_reel, "", "code", "", nom_bloc, texte))
    regroupes = []  # les petits morceaux voisins vont ensemble : seuls, ils brouillent le classement par le sens
    for p in passages:
        if regroupes and len(regroupes[-1][6]) + len(p[6]) <= CODE_REGROUPE:
            r = regroupes[-1]
            noms = r[5] if p[5] in r[5].split(", ") else f"{r[5]}, {p[5]}"
            regroupes[-1] = (*r[:5], noms, f"{r[6]}\n\n{p[6]}")
        else:
            regroupes.append(p)
    return [(*r[:5], f"{rel} :: {r[5][:120]}", r[6]) for r in regroupes], refus


def empreinte(racine: Path) -> str:
    h = hashlib.sha256(Path(__file__).read_bytes())  # une nouvelle version de mem refait aussi l'index
    h.update(b"sens" if sens_actif() else b"mots")  # index fait avec MEM_SENS=0 : refait quand le sens revient
    h.update(b"code" if MODE_CODE else b"notes")
    for p in notes(racine):
        st = p.stat()
        h.update(f"{p.relative_to(racine)}\0{st.st_mtime_ns}\0{st.st_size}\n".encode())
    return h.hexdigest()


def empreinte_de_la_base(base: Path) -> str | None:
    try:
        con = sqlite3.connect(f"file:{base}?mode=ro", uri=True)
        try:
            row = con.execute("SELECT valeur FROM info WHERE cle = 'empreinte'").fetchone()
        finally:
            con.close()
        return row[0] if row else None
    except sqlite3.Error:
        return None


def indexer(racine: Path, base: Path, si_perime: bool = False) -> tuple[int, int]:
    """Reconstruit l'index sous verrou, dans un fichier temporaire unique, puis le met en place d'un coup."""
    base.parent.mkdir(parents=True, exist_ok=True)
    with open(base.with_suffix(".verrou"), "w") as verrou:
        try:
            fcntl.flock(verrou, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(tr("mem : index en cours de réfection par un autre agent, attente…",
                     "mem: index being rebuilt by another agent, waiting…"), file=sys.stderr, flush=True)
            fcntl.flock(verrou, fcntl.LOCK_EX)
        if si_perime and empreinte_de_la_base(base) == empreinte(racine):
            return 0, 0  # refait entre-temps par un autre agent
        fd, tmp = tempfile.mkstemp(dir=base.parent, prefix=base.stem + ".", suffix=".tmp")
        os.close(fd)
        try:
            con = sqlite3.connect(tmp)
            con.executescript(
                """
                CREATE VIRTUAL TABLE passages USING fts5(
                    texte, titre, fichier UNINDEXED, ligne UNINDEXED, date UNINDEXED,
                    type UNINDEXED, auteur UNINDEXED, tokenize='unicode61 remove_diacritics 2');
                CREATE TABLE refus(fichier TEXT, ligne INTEGER, motif TEXT);
                CREATE TABLE info(cle TEXT PRIMARY KEY, valeur TEXT);
                CREATE TABLE journaux(fichier TEXT PRIMARY KEY);
                """
            )
            total = 0
            emp = empreinte(racine)
            for chemin in notes(racine):
                passages, refus = (decouper_code if MODE_CODE else decouper)(chemin, racine)
                con.executemany(
                    "INSERT INTO passages(fichier, ligne, date, type, auteur, titre, texte) VALUES (?,?,?,?,?,?,?)",
                    passages,
                )
                con.executemany("INSERT INTO refus VALUES (?,?,?)", refus)
                if any("POINT DE REPRISE" in p[5].upper() for p in passages):  # note-journal (état daté)
                    con.execute("INSERT INTO journaux VALUES (?)", (str(chemin.relative_to(racine)),))
                total += len(passages)
            calculer_sens(con, base)
            con.executemany("INSERT INTO info VALUES (?, ?)", [("racine", str(racine)), ("empreinte", emp)])
            con.commit()
            nb_refus = con.execute("SELECT count(*) FROM refus").fetchone()[0]
            con.close()
            os.chmod(tmp, 0o600)
            os.replace(tmp, base)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
    return total, nb_refus


def assurer_index(racine: Path, base: Path) -> None:
    """Index à jour avant de lire ; si un autre agent est en train de le refaire, on l'attend."""
    if empreinte_de_la_base(base) != empreinte(racine):
        indexer(racine, base, si_perime=True)


def requete_fts(termes: list[str], operateur: str) -> str:
    morceaux = []
    for t in termes:
        if "-" in t and not any(t in g for g in SYNONYMES):
            morceaux.append('"' + " ".join(t.split("-")) + '"')
        elif t.isdigit():  # « 424 » trouve aussi T424 et P424
            morceaux.append(f'("{t}" OR "T{t}" OR "P{t}")')
        else:
            groupe = next((g for g in SYNONYMES if t in g), {t})
            morceaux.append("(" + " OR ".join(
                '"' + " ".join(m.split("-")) + '"' if "-" in m else f'"{m}"*' if len(m) >= 5 else f'"{m}"'
                for m in sorted(groupe)) + ")")
    return f" {operateur} ".join(morceaux)


def termes_de(mots: str) -> list[str]:
    # « mot-composé » reste une expression ; les mots vides et interrogatifs ne comptent pas.
    mots = mots.lower()
    for expr, mot in EXPRESSIONS.items():
        mots = mots.replace(expr, mot)
    termes = [t for t in re.findall(r"\w+(?:-\w+)+|\w+", mots) if t not in MOTS_VIDES | RECENT]
    if not termes:
        raise SystemExit(tr("mem : rien à chercher", "mem: nothing to search for"))
    return termes


def date_ou_aujourd_hui(date: str) -> dt.date:
    try:
        return dt.date.fromisoformat(date)
    except ValueError:
        return dt.date.today()


def normaliser_dans(racine: Path, dans: str) -> str | None:
    """« project », « ./project/ », un chemin absolu dans la mémoire → « project/ » (dossier) ou « project/x.md »
    (une note) ; None si rien de tel n'existe dans ce dossier mémoire."""
    chemin = Path(dans).expanduser()
    if chemin.is_absolute():
        try:
            chemin = chemin.resolve().relative_to(racine.resolve())
        except ValueError:
            return None
    cible = racine / chemin
    rel = chemin.as_posix().strip("/")
    if rel in ("", "."):
        return ""
    if cible.is_dir():
        return rel + "/"
    return rel if cible.is_file() else None


def filtre_dans(dans: str | None, colonne: str = "fichier") -> tuple[str, list]:
    """Clause SQL : la note elle-même, ou toutes les notes sous le dossier (préfixe exact, sans joker LIKE)."""
    if not dans:
        return "", []
    if dans.endswith("/"):
        return f" AND substr({colonne}, 1, ?) = ?", [len(dans), dans]
    return f" AND {colonne} = ?", [dans]


def chercher(racine: Path, base: Path, mots: str, n=5, type_=None, depuis=None, archives=False, auteur=None,
             reclasse=True, dans=None):
    """ET d'abord, puis OU pour compléter ; archives seulement si demandées ou s'il manque des résultats ;
    BM25 (titre ×2) pondéré par la récence ; au plus PAR_FICHIER passages par fichier.
    `dans` (déjà normalisé) : seulement cette note ou ce sous-dossier ; « archive/… » cherche alors dans les archives."""
    assurer_index(racine, base)
    if dans and dans.startswith("archive"):
        archives = True
    termes = termes_de(mots)
    recent = not MODE_CODE and any(t in RECENT for t in re.findall(r"\w+", mots.lower()))
    con = sqlite3.connect(f"file:{base}?mode=ro", uri=True)
    aujourd_hui = dt.date.today()

    def lancer(operateur: str, avec_archives: bool):
        sql = (f"SELECT fichier, ligne, date, type, titre, texte, bm25(passages, 1.0, {POIDS_TITRE}) FROM passages "
               "WHERE passages MATCH ?")
        args: list = [requete_fts(termes, operateur)]
        if not avec_archives:
            sql += " AND type != 'archive'"
        if not type_ and not dans:
            sql += " AND type != 'index'"  # MEMORY.md est déjà dans le contexte de chaque session
        clause, valeurs = filtre_dans(dans)
        sql += clause
        args += valeurs
        if type_:
            sql += " AND type = ?"
            args.append(type_)
        if depuis:
            sql += " AND date >= ?"
            args.append(depuis)
        if auteur:
            sql += " AND (auteur = '' OR auteur = ?)"
            args.append(auteur)
        sql += " ORDER BY 7 LIMIT 200"
        return con.execute(sql, args).fetchall()

    def recence(date: str) -> float:
        try:
            jours = (aujourd_hui - dt.date.fromisoformat(date)).days
        except ValueError:
            return 0.0
        return max(0.0, 1.0 - jours / 90)

    journaux = {r[0] for r in con.execute("SELECT fichier FROM journaux")}

    def poids(r) -> float:
        # bm25 est négatif : plus il est grand en valeur absolue, mieux c'est.
        p = r[6] * (1 + 0.5 * recence(r[2]))
        if r[1] == 1:
            p *= POIDS_DESCRIPTION
        if r[0] in journaux and not recent and (aujourd_hui - date_ou_aujourd_hui(r[2])).days > AGE_JOURNAL:
            p *= FACTEUR_JOURNAL  # vieil état : derrière les règles, sauf si l'on demande le « dernier »
        return p

    # Classement par mots : ET puis OU, archives en dernier ; candidats ordonnés, sans plafond par fichier.
    vus, mots_ordonnes = set(), []
    for operateur, avec_archives in (("AND", archives), ("OR", archives), ("AND", True), ("OR", True)):
        if len(mots_ordonnes) >= max(n * 10, 100):
            break
        lot = sorted(lancer(operateur, avec_archives), key=poids)
        if recent:
            lot.sort(key=lambda r: r[2], reverse=True)  # tri stable : à date égale, le score départage
        for r in lot:
            if (r[0], r[1]) not in vus:
                vus.add((r[0], r[1]))
                mots_ordonnes.append(r)

    candidats = mots_ordonnes
    sens_ordonnes = [] if recent else proches(con, base, mots, archives, type_, depuis, auteur, journaux, dans)
    if sens_ordonnes:  # fusion des rangs (RRF) : un passage bien placé par l'un ou l'autre remonte
        score, ligne_de = collections.Counter(), {}
        for poids_, liste in ((1.0, mots_ordonnes), (POIDS_SENS, sens_ordonnes)):
            for rang, r in enumerate(liste[:100], start=1):
                score[(r[0], r[1])] += poids_ / (K_RRF + rang)
                ligne_de.setdefault((r[0], r[1]), r)
        candidats = [(*ligne_de[c][:6], -sc) for c, sc in score.most_common()]
    con.close()

    reclasse = reclasse and not recent and reclassement_actif()  # « dernier » : l'ordre des dates prime
    resultats, par_fichier = [], collections.Counter()
    for r in candidats:
        if par_fichier[r[0]] < PAR_FICHIER:
            par_fichier[r[0]] += 1
            resultats.append(r)
            if len(resultats) >= (max(n, K_RECLASSE) if reclasse else n):
                break
    if reclasse:
        resultats = reclasser(mots, resultats)
    return resultats[:n]


def reclassement_actif() -> bool:
    return os.environ.get("MEM_RECLASSER", "1") != "0"


def node_pour_reclasser() -> str | None:
    import shutil

    def version(p: Path):
        return tuple(int(x) for x in re.findall(r"\d+", p.parent.parent.name))
    # D'abord la version par défaut de nvm (~/.nvm/alias/default, ex. « 24 »), comme le service.
    try:
        defaut = (Path.home() / ".nvm" / "alias" / "default").read_text().strip().lstrip("v")
    except OSError:
        defaut = ""
    if re.fullmatch(r"\d+(\.\d+)*", defaut):
        nvm = sorted(Path.home().glob(f".nvm/versions/node/v{defaut}*/bin/node"), key=version)
        if nvm:
            return str(nvm[-1])
    if shutil.which("node"):
        return shutil.which("node")
    nvm = sorted(Path.home().glob(".nvm/versions/node/v*/bin/node"), key=version)
    return str(nvm[-1]) if nvm else None


def _noter_http(question: str, docs: list) -> list:
    """llama-server (--rerank) sur le socket Unix : POST /v1/rerank, notes remises dans l'ordre des docs.
    Lève http.client.HTTPException si le serveur ne parle pas HTTP (ancien serveur.mjs)."""
    import http.client
    import socket

    class _Unix(http.client.HTTPConnection):
        def connect(self):
            self.sock = socket.socket(socket.AF_UNIX)
            self.sock.settimeout(DELAI_RECLASSE)
            self.sock.connect(str(SOCKET_RECLASSEUR))

    c = _Unix("localhost", timeout=DELAI_RECLASSE)
    try:
        c.request("POST", "/v1/rerank", json.dumps({"query": question, "documents": docs, "top_n": len(docs)}),
                  {"Content-Type": "application/json"})
        r = c.getresponse()
        corps = r.read()
    finally:
        c.close()
    if r.status != 200:
        raise ValueError(f"le serveur a répondu {r.status}")
    notes = [None] * len(docs)
    for x in json.loads(corps).get("results", []):
        if isinstance(x.get("index"), int) and 0 <= x["index"] < len(docs):
            notes[x["index"]] = x.get("relevance_score")
    return notes


def _noter_ligne(question: str, docs: list) -> list:
    """Ancien serveur.mjs : une ligne JSON {q, docs} aller, une ligne de notes retour."""
    import socket

    s = socket.socket(socket.AF_UNIX)
    s.settimeout(DELAI_RECLASSE)
    with s:
        s.connect(str(SOCKET_RECLASSEUR))
        s.sendall((json.dumps({"q": question, "docs": docs}) + "\n").encode())
        recu = b""
        while not recu.endswith(b"\n"):
            bloc = s.recv(65536)
            if not bloc:
                break
            recu += bloc
    notes = json.loads(recu)
    if isinstance(notes, dict):
        raise ValueError("le serveur a refusé la demande")
    return notes


def noter_par_serveur(question: str, docs: list) -> list | None:
    """Notes du serveur du reclasseur ; None s'il ne tourne pas (pas de socket, connexion refusée).
    llama-server (HTTP, 10 passages notés ensemble) d'abord ; s'il ne répond pas en HTTP, l'ancien serveur.mjs."""
    import http.client
    import socket

    if SOCKET_RECLASSEUR is None or not SOCKET_RECLASSEUR.is_socket():
        return None
    try:
        return _noter_http(question, docs)
    except (ConnectionRefusedError, FileNotFoundError):
        return None
    except (http.client.HTTPException, ConnectionResetError, BrokenPipeError):
        pass  # pas du HTTP : ancien serveur
    try:
        return _noter_ligne(question, docs)
    except (ConnectionRefusedError, FileNotFoundError):
        return None
    except socket.timeout:
        raise OSError("délai dépassé")


def reclasser(question: str, resultats: list) -> list:
    """Renote les K_RECLASSE premiers passages et les range par note (à note égale, l'ordre de mem).
    En cas d'échec : un avis sur la sortie d'erreur et l'ordre reçu, inchangé."""
    import shutil

    tete, reste = resultats[:K_RECLASSE], resultats[K_RECLASSE:]
    if len(tete) < 2:
        return resultats
    script, node = RECLASSEUR / "reclasser.mjs", node_pour_reclasser()
    docs = [(f"{r[4]}\n{r[5]}" if MODE_CODE else f"{r[0]} — {r[4]}\n{r[5]}")[:LONGUEUR_RECLASSE] for r in tete]
    try:
        notes = noter_par_serveur(question, docs)
        if notes is None:
            if not script.is_file() or not node:
                raise OSError("reclasseur ou node absent")
            cmd = [node, str(script)]
            if shutil.which("unshare"):
                cmd = ["unshare", "-rn", *cmd]  # aucun accès réseau, quoi que fasse la bibliothèque
            sortie = subprocess.run(cmd, input=json.dumps({"q": question, "docs": docs}), capture_output=True,
                                    text=True, timeout=DELAI_RECLASSE, cwd=RECLASSEUR, check=True).stdout
            notes = json.loads(sortie)
        if len(notes) != len(tete) or not all(isinstance(x, (int, float)) for x in notes):
            raise ValueError("réponse inattendue")
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        print(tr(f"mem : reclassement indisponible ({type(e).__name__}), classement par mots et sens",
                 f"mem: reranking unavailable ({type(e).__name__}), ranked by words and meaning"), file=sys.stderr)
        return resultats
    ordre = sorted(range(len(tete)), key=lambda i: -notes[i])  # tri stable
    return [tete[i] for i in ordre] + reste


def proches(con, base: Path, question: str, archives, type_, depuis, auteur, journaux, dans=None) -> list:
    """Passages classés par le sens (cosinus avec la question) ; [] si pas de vecteurs ou pas d'Ollama."""
    if not sens_actif() or not base_sens(base).exists():
        return []
    q = vecteurs([question], delai=10)
    if not q:
        return []
    try:
        import numpy as np
    except ImportError:
        return []

    con.execute("ATTACH DATABASE ? AS c", (f"file:{base_sens(base)}?mode=ro",))
    sql = ("SELECT p.fichier, p.ligne, p.date, p.type, p.titre, p.texte, c.v.v FROM passages p "
           "JOIN sens s ON s.rowid = p.rowid JOIN c.v ON c.v.h = s.h WHERE 1")
    args: list = []
    if not archives:
        sql += " AND p.type != 'archive'"
    if type_:
        sql += " AND p.type = ?"
        args.append(type_)
    elif not dans:
        sql += " AND p.type != 'index'"
    clause, valeurs = filtre_dans(dans, "p.fichier")
    sql += clause
    args += valeurs
    if depuis:
        sql += " AND p.date >= ?"
        args.append(depuis)
    if auteur:
        sql += " AND (p.auteur = '' OR p.auteur = ?)"
        args.append(auteur)
    lignes = con.execute(sql, args).fetchall()
    if not lignes:
        return []
    m = np.frombuffer(b"".join(r[6] for r in lignes), dtype=np.float32).reshape(len(lignes), -1)
    cos = m @ q[0]
    ordre = np.argsort(-cos)[:100]
    return [(*lignes[i][:6], -float(cos[i])) for i in ordre]


