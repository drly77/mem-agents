CONV_SENS_A_LA_VOLEE = 300  # une recherche calcule le sens des nouveaux passages s'ils sont peu nombreux
# Fusion RRF : mots ×1, sens ×0,5, comme pour les notes. Trois bancs (54 questions, 17/11/2026) : ×0,5 et ×4
# se valent en moyenne (~0,71 et ~0,69), ×0,5 gagne sur le jeu tenu à l'écart (0,78 contre 0,67) ; le reclasseur
# n'y gagne rien et coûte ~3-4 s (--reclasser).
CONV_POIDS_SENS = float(os.environ.get("MEM_RETROUVER_POIDS_SENS", "0.5"))
CONV_BALISES = re.compile(
    r"^\s*<(system-reminder|task-notification|command-name|command-message|command-args|local-command-stdout|"
    r"local-command-caveat|bash-input|bash-stdout|bash-stderr|artifact-content[\w-]*|fork-boilerplate|"
    r"user-prompt-submit-hook)\b")
CONV_RAPPEL = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)
CONV_PAIR = re.compile(r'<cross-session-message\b[^>]*?from-name="([^"]+)"[^>]*>(.*?)</cross-session-message>', re.S)
CONV_COLLE = re.compile(r"</?pasted_content[^>]*>")
CONV_COMPACT = "This session is being continued"


def conv_reglage(nom: str) -> list[str]:
    """~/.config/mem/<nom> : une valeur par ligne (# commente) ; [] si absent."""
    try:
        texte = (Path.home() / ".config" / "mem" / nom).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return []
    return [l.strip() for l in texte.splitlines() if l.strip() and not l.lstrip().startswith("#")]


def conv_utilisateur() -> str:
    """Nom donné aux messages de l'humain : $MEM_UTILISATEUR, sinon ~/.config/mem/utilisateur, sinon « user »."""
    return os.environ.get("MEM_UTILISATEUR") or next(iter(conv_reglage("utilisateur")), "") or tr("utilisateur", "user")


def conv_canal() -> re.Pattern | None:
    """Messages tapés par un canal (« [Salon — … · 101500] texte ») : noms dans ~/.config/mem/canaux."""
    noms = conv_reglage("canaux")
    if not noms:
        return None
    return re.compile(r"^\s*\[(" + "|".join(re.escape(n) for n in noms) + r")\b[^\]]*\]\s*")


def conv_textes(contenu) -> list[str]:
    if isinstance(contenu, str):
        return [contenu]
    return [x.get("text", "") for x in contenu or [] if isinstance(x, dict) and x.get("type") == "text"]


def conv_messages(d: dict, agent: str, humain: str, canal: re.Pattern | None) -> list[tuple[str, str]]:
    """(qui, texte) à indexer pour une ligne de transcription ; [] si elle n'a rien d'un échange."""
    origine = d.get("origin") if isinstance(d.get("origin"), dict) else {}
    if origine.get("kind") == "peer" and isinstance(origine.get("body"), str) and d.get("type") == "user":
        return [(f"pair:{origine.get('name') or '?'}", origine["body"])]  # rangé en isMeta par Claude Code
    if d.get("isSidechain") or d.get("isMeta") or d.get("isCompactSummary") or origine.get("kind") == "task-notification":
        return []
    m = d.get("message") or {}
    role = m.get("role")
    if d.get("type") == "assistant" and role == "assistant":
        return [(agent or "agent", t) for t in conv_textes(m.get("content")) if t.strip()]
    if d.get("type") != "user" or role != "user":
        return []
    sortie = []
    for t in conv_textes(m.get("content")):
        if t.lstrip().startswith(CONV_COMPACT) or CONV_BALISES.match(t):
            continue
        pairs = CONV_PAIR.findall(t)
        if pairs:
            sortie += [(f"pair:{nom}", corps.strip()) for nom, corps in pairs]
            continue
        t = CONV_RAPPEL.sub("", t)
        par_canal = canal.match(t) if canal else None
        if par_canal:
            sortie.append((f"{humain} ({par_canal.group(1)})", t[par_canal.end():]))
        elif "<pasted_content" in t:
            sortie.append((tr(f"{humain} (collé)", f"{humain} (pasted)"), CONV_COLLE.sub("", t)))
        elif t.strip():
            sortie.append((humain, t))
    return sortie


def conv_morceaux(texte: str) -> list[str]:
    """Recoupe un long message aux lignes vides, en passages de CONV_TAILLE au plus."""
    blocs, courant = [], ""
    for para in re.split(r"\n\s*\n", texte.strip()):
        while len(para) > CONV_TAILLE:
            if courant:
                blocs.append(courant)
                courant = ""
            blocs.append(para[:CONV_TAILLE])
            para = para[CONV_TAILLE:]
        if courant and len(courant) + len(para) + 2 > CONV_TAILLE:
            blocs.append(courant)
            courant = para
        else:
            courant = f"{courant}\n\n{para}" if courant else para
    if courant.strip():
        blocs.append(courant)
    return blocs


def conv_filtrer(texte: str) -> tuple[str, int]:
    """Texte passé au filtre de secrets de mem, et nombre de lignes retirées en entier."""
    garde, retirees, dans_bloc = [], 0, False
    for ligne in texte.splitlines():
        if DEBUT_BLOC.search(ligne):
            dans_bloc = True
        if dans_bloc:
            retirees += 1
            if FIN_BLOC.search(ligne):
                dans_bloc = False
            continue
        propre, _ = masquer(ligne)
        if propre is None:
            retirees += 1
        else:
            garde.append(propre)
    return "\n".join(garde), retirees


