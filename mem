def conv_ouvrir(base: Path) -> sqlite3.Connection:
    base.parent.mkdir(parents=True, exist_ok=True)
    if not base.exists():
        os.close(os.open(base, os.O_CREAT | os.O_WRONLY, 0o600))  # 0600 d'emblée, jamais avec l'umask
    os.chmod(base, 0o600)
    con = sqlite3.connect(base, timeout=120)
    con.execute("PRAGMA journal_mode=WAL")
    con.executescript(CONV_SCHEMA)
    return con


def conv_supprimer(con: sqlite3.Connection, ids: list[int]) -> None:
    for i in ids:
        r = con.execute("SELECT texte, qui FROM passages WHERE id = ?", (i,)).fetchone()
        con.execute("INSERT INTO mots(mots, rowid, texte, qui) VALUES ('delete', ?, ?, ?)", (i, *r))
        con.execute("DELETE FROM passages WHERE id = ?", (i,))
        con.execute("DELETE FROM sens WHERE id = ?", (i,))


def conv_lire_nouveau(con: sqlite3.Connection, chemin: Path, humain: str, canal) -> tuple[int, int]:
    """Indexe les lignes complètes ajoutées depuis le dernier passage ; (passages, lignes retirées)."""
    connu = con.execute("SELECT octet, ligne, agent FROM fichiers WHERE chemin = ?", (str(chemin),)).fetchone()
    octet, num, agent = connu or (0, 0, "")
    taille = chemin.stat().st_size
    if taille < octet:  # fichier réécrit : on repart de zéro pour lui
        conv_supprimer(con, [i for (i,) in con.execute("SELECT id FROM passages WHERE session = ?", (chemin.stem,))])
        octet, num, agent = 0, 0, ""
    if taille == octet:
        return 0, 0
    session, projet = chemin.stem, conv_projet(chemin.parent.name)
    ajoutes = retirees = 0
    with open(chemin, "rb") as f:
        f.seek(octet)
        for brut in f:
            if not brut.endswith(b"\n"):
                break  # ligne en cours d'écriture : la prochaine fois
            debut = octet
            octet += len(brut)
            num += 1
            try:
                d = json.loads(brut)
            except ValueError:
                continue
            if not isinstance(d, dict):
                continue
            if d.get("type") == "agent-name" and d.get("agentName"):
                agent = d["agentName"]
                continue
            date = str(d.get("timestamp") or "")[:16].replace("T", " ")
            for qui, texte in conv_messages(d, agent, humain, canal):
                propre, r = conv_filtrer(texte)
                retirees += r
                for k, bout in enumerate(conv_morceaux(propre)):
                    cur = con.execute(
                        "INSERT INTO passages(session, projet, ligne, octet, morceau, date, agent, qui, texte) "
                        "VALUES (?,?,?,?,?,?,?,?,?)", (session, projet, num, debut, k, date, agent, qui, bout))
                    con.execute("INSERT INTO mots(rowid, texte, qui) VALUES (?,?,?)", (cur.lastrowid, bout, qui))
                    ajoutes += 1
    con.execute("INSERT OR REPLACE INTO fichiers VALUES (?,?,?,?)", (str(chemin), octet, num, agent))
    return ajoutes, retirees


def conv_sens(con: sqlite3.Connection, limite: int | None = None, bavard: bool = False) -> int:
    """Vecteurs bge-m3 des passages qui n'en ont pas ; s'arrête sans erreur si Ollama ne répond pas."""
    if not sens_actif():
        return 0
    a_faire = con.execute("SELECT p.id, p.texte FROM passages p LEFT JOIN sens s ON s.id = p.id "
                          "WHERE s.id IS NULL").fetchall()
    if limite is not None and len(a_faire) > limite:
        return 0  # trop pour une recherche : « mem retrouver --indexer » s'en charge
    faits = 0
    for i in range(0, len(a_faire), SENS_LOT):
        lot = a_faire[i:i + SENS_LOT]
        if bavard and sys.stderr.isatty():
            print(tr(f"\rmem : sens, {i}/{len(a_faire)} passages…", f"\rmem: embeddings, {i}/{len(a_faire)} passages…"),
                  end="", file=sys.stderr, flush=True)
        vs = vecteurs([t[:2000] for _, t in lot])
        if vs is None:
            break
        con.executemany("INSERT OR REPLACE INTO sens VALUES (?, ?)", [(r[0], v.tobytes()) for r, v in zip(lot, vs)])
        con.commit()
        faits += len(lot)
    if bavard and sys.stderr.isatty():
        print("\r\033[K", end="", file=sys.stderr, flush=True)
    return faits


def conv_indexer(source: Path, base: Path, sens: bool = True, limite_sens: int | None = None,
                 bavard: bool = False) -> tuple[int, int, int]:
    """Ajoute les messages nouveaux de toutes les transcriptions ; (passages, lignes retirées, vecteurs).
    Deux verrous : les mots sous verrou bloquant (court) ; le sens sous un verrou sans attente, pour qu'un long
    calcul ne bloque pas les recherches, qui cherchent alors avec les vecteurs déjà faits."""
    con = conv_ouvrir(base)
    humain, canal = conv_utilisateur(), conv_canal()
    with open(base.with_suffix(".verrou"), "w") as verrou:
        fcntl.flock(verrou, fcntl.LOCK_EX)
        ajoutes = retirees = 0
        for chemin in conv_fichiers(source):
            a, r = conv_lire_nouveau(con, chemin, humain, canal)
            ajoutes, retirees = ajoutes + a, retirees + r
            con.commit()
        con.execute("INSERT INTO info VALUES ('retirees', ?) ON CONFLICT(cle) DO UPDATE SET valeur = valeur + ?",
                    (retirees, retirees))
        con.commit()
    vecs = 0
    if sens:
        with open(base.with_suffix(".sens.verrou"), "w") as verrou:
            try:
                fcntl.flock(verrou, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                if bavard:
                    print(tr("mem : sens déjà en calcul par un autre processus",
                             "mem: embeddings already being computed by another process"), file=sys.stderr)
            else:
                vecs = conv_sens(con, limite_sens, bavard)
    con.close()
    return ajoutes, retirees, vecs


def conv_filtres(qui, agent, depuis, jusqua, projet) -> tuple[str, list]:
    sql, args = "", []
    for colonne, valeur, motif in (("p.qui", qui, "{}%"), ("p.agent", agent, "{}"), ("p.projet", projet, "%{}%")):
        if valeur:
            sql += f" AND {colonne} LIKE ?"
            args.append(motif.format(valeur))
    if depuis:
        sql += " AND p.date >= ?"
        args.append(depuis)
    if jusqua:
        sql += " AND p.date < ?"
        args.append(jusqua + "~")  # « 2026-10-31 » garde toute la journée
    return sql, args


def conv_chercher(base: Path, question: str, n: int = 5, qui=None, agent=None, depuis=None, jusqua=None,
                  projet=None, reclasse: bool = False) -> list[tuple]:
    """(session, ligne, date, qui, agent, texte, projet, morceau) : mots et sens fusionnés (RRF),
    un seul passage par message, reclasseur de mem seulement sur demande."""
    termes = termes_de(question)
    con = sqlite3.connect(f"file:{base}?mode=ro", uri=True)
    clause, valeurs = conv_filtres(qui, agent, depuis, jusqua, projet)
    colonnes = "p.session, p.ligne, p.date, p.qui, p.agent, p.texte, p.projet, p.morceau"
    par_mots, vus = [], set()
    for operateur in ("AND", "OR"):
        if len(par_mots) >= 100:
            break
        sql = (f"SELECT {colonnes} FROM mots JOIN passages p ON p.id = mots.rowid WHERE mots MATCH ?{clause} "
               "ORDER BY bm25(mots) LIMIT 200")
        for r in con.execute(sql, [requete_fts(termes, operateur), *valeurs]):
            if (r[0], r[1], r[7]) not in vus:
                vus.add((r[0], r[1], r[7]))
                par_mots.append(r)
    par_sens = []
    q = vecteurs([question], delai=10) if sens_actif() else None
    if q:
        import numpy as np
        lignes = con.execute(f"SELECT {colonnes}, s.v FROM passages p JOIN sens s ON s.id = p.id WHERE 1{clause}",
                             valeurs).fetchall()
        if lignes:
            m = np.frombuffer(b"".join(r[8] for r in lignes), dtype=np.float32).reshape(len(lignes), -1)
            cos = m @ q[0]
            par_sens = [lignes[i][:8] for i in np.argsort(-cos)[:100]]
    con.close()

    score, ligne_de = collections.Counter(), {}
    for poids_, liste in ((1.0, par_mots), (CONV_POIDS_SENS, par_sens)):
        for rang, r in enumerate(liste[:100], start=1):
            score[(r[0], r[1], r[7])] += poids_ / (K_RRF + rang)
            ligne_de.setdefault((r[0], r[1], r[7]), r)
    reclasse = reclasse and reclassement_actif()
    resultats, messages = [], set()
    for cle, _ in score.most_common():
        r = ligne_de[cle]
        if (r[0], r[1]) in messages:
            continue  # un seul morceau par message : le mieux classé
        messages.add((r[0], r[1]))
        resultats.append(r)
        if len(resultats) >= (max(n, K_RECLASSE) if reclasse else n):
            break
    if reclasse and len(resultats) > 1:
        # reclasser lit r[0] — r[4] puis r[5] : on lui passe (date qui, …, agent, texte).
        pour_mem = [(f"{r[2]} {r[3]}", r[1], r[2], "", r[4], r[5], 0) for r in resultats]
        place = {id(x): i for i, x in enumerate(pour_mem)}
        resultats = [resultats[place[id(x)]] for x in reclasser(question, pour_mem)]
    return resultats[:n]


def conv_extrait(texte: str, question: str, nb: int = 6) -> list[str]:
    """Les nb lignes autour de celle qui porte le plus de mots de la question (le début, à défaut)."""
    import unicodedata

    def plat(s: str) -> str:
        return "".join(c for c in unicodedata.normalize("NFD", s.lower()) if unicodedata.category(c) != "Mn")
    lignes = [l for l in texte.splitlines() if l.strip()]
    try:
        racines = [plat(t)[:5] for t in termes_de(question)]
    except SystemExit:
        racines = []
    compte = [sum(r in plat(l) for r in racines) for l in lignes]
    meilleure = max(range(len(lignes)), key=lambda i: compte[i], default=0)
    debut = max(0, min(meilleure - 1, len(lignes) - nb)) if compte and compte[meilleure] else 0
    return lignes[debut:debut + nb]


def conv_afficher(resultats: list[tuple], question: str = "") -> None:
    if not resultats:
        print(tr("aucun résultat", "no results"))
        return
    for session, ligne, date, qui, agent, texte, projet, _ in resultats:
        chez = tr(f" (session de {agent})", f" (session of {agent})") if agent and not qui.startswith(agent) else ""
        print(f"{session[:8]}:{ligne}  {date}  {qui}{chez}  [{projet}]")
        for l in conv_extrait(texte, question):
            print("    " + (l if len(l) <= 220 else l[:217] + "…"))
        print()


def conv_voir(base: Path, cible: str, autour: int = 3) -> int:
    m = re.fullmatch(r"([0-9a-f-]{4,36}):(\d+)", cible)
    if not m:
        print(tr("mem retrouver --voir SESSION:LIGNE (tel qu'affiché par mem retrouver)",
                 "mem recall --show SESSION:LINE (as printed by mem recall)"), file=sys.stderr)
        return 2
    con = sqlite3.connect(f"file:{base}?mode=ro", uri=True)
    sessions = {s for (s,) in con.execute("SELECT DISTINCT session FROM passages WHERE session LIKE ?",
                                          (m.group(1) + "%",))}
    if len(sessions) != 1:
        print(tr(f"mem : session {m.group(1)} " + ("inconnue" if not sessions else "ambiguë"),
                 f"mem: session {m.group(1)} " + ("unknown" if not sessions else "ambiguous")), file=sys.stderr)
        return 1
    session, ligne = sessions.pop(), int(m.group(2))
    lignes = [l for (l,) in con.execute("SELECT DISTINCT ligne FROM passages WHERE session = ? ORDER BY ligne",
                                        (session,))]
    if ligne not in lignes:
        print(tr(f"mem : rien d'indexé à {session[:8]}:{ligne}", f"mem: nothing indexed at {session[:8]}:{ligne}"),
              file=sys.stderr)
        return 1
    i = lignes.index(ligne)
    choisies = lignes[max(0, i - autour): i + autour + 1]
    marques = ",".join("?" * len(choisies))
    for l, date, qui, texte in con.execute(
            "SELECT ligne, date, qui, group_concat(texte, char(10) || char(10)) FROM "
            f"(SELECT * FROM passages WHERE session = ? AND ligne IN ({marques}) ORDER BY ligne, morceau) "
            "GROUP BY ligne, qui ORDER BY ligne", (session, *choisies)):
        print(f"{'>>' if l == ligne else '  '} {session[:8]}:{l}  {date}  {qui}")
        for t in texte.splitlines():
            print("     " + t)
        print()
    return 0


def conv_etat(base: Path, source: Path) -> int:
    con = conv_ouvrir(base)
    total = con.execute("SELECT count(*) FROM passages").fetchone()[0]
    avec_sens = con.execute("SELECT count(*) FROM sens s JOIN passages p ON p.id = s.id").fetchone()[0]
    retirees = (con.execute("SELECT valeur FROM info WHERE cle = 'retirees'").fetchone() or (0,))[0]
    lus = con.execute("SELECT count(*) FROM fichiers").fetchone()[0]
    print(tr(f"base : {base}", f"database: {base}"))
    print(tr(f"transcriptions : {source} ({len(conv_fichiers(source))} fichiers, {lus} lus)",
             f"transcripts: {source} ({len(conv_fichiers(source))} files, {lus} read)"))
    print(tr(f"passages : {total}, avec sens : {avec_sens}, lignes retirées par le filtre de secrets : {retirees}",
             f"passages: {total}, with embeddings: {avec_sens}, lines withheld by the secret filter: {retirees}"))
    for qui, nb in con.execute("SELECT CASE WHEN qui LIKE 'pair:%' THEN 'pair:*' WHEN qui = agent OR qui = 'agent' "
                               "THEN 'agents' ELSE qui END AS k, count(*) FROM passages GROUP BY k ORDER BY 2 DESC"):
        print(f"  {qui} : {nb}")
    if avec_sens < total:
        print(tr("sens incomplet : « mem retrouver --indexer » le termine (Ollama et bge-m3 requis)",
                 "embeddings incomplete: \"mem recall --index\" finishes them (Ollama and bge-m3 needed)"))
    return 0


def code(args) -> int:
    """mem code : chercher dans le code du dépôt courant (ou --depot), index à part (~/.local/share/mem/<dépôt>.code.db)."""
    global MODE_CODE, K_RECLASSE, LONGUEUR_RECLASSE
    depot = args.depot.expanduser() if args.depot else depot_courant()
    if depot is None or not depot.is_dir():
        print(tr("mem code : pas de dépôt git ici ; donner --depot DOSSIER", "mem code: no git repository here; pass --repo DIR"),
              file=sys.stderr)
        return 2
    depot = depot.resolve()
    MODE_CODE, K_RECLASSE, LONGUEUR_RECLASSE = True, K_RECLASSE_CODE, LONGUEUR_RECLASSE_CODE
    base = Path(os.environ["MEM_CODE_DB"]).expanduser() if os.environ.get("MEM_CODE_DB") else _donnees(depot, ".code.db")
    if args.indexer:
        total, refus = indexer(depot, base)
        print(tr(f"{total} passages de code indexés, {refus} lignes masquées ou retirées",
                 f"{total} code passages indexed, {refus} lines masked or withheld"))
        return 0
    if args.bench:
        return bench(depot, base, args.bench)
    if not args.mots:
        print(tr("mem code : que chercher ?", "mem code: what should I search for?"), file=sys.stderr)
        return 2
    dans = None
    if args.dans is not None:
        dans = normaliser_dans(depot, args.dans)
        if dans is None:
            print(tr(f"mem code : « {args.dans} » n'existe pas dans {depot}", f"mem code: \"{args.dans}\" does not exist in {depot}"),
                  file=sys.stderr)
            return 2
    print(tr(f"(code : {depot}" + (f", dans {dans}" if dans else "") + ")",
             f"(code: {depot}" + (f", in {dans}" if dans else "") + ")"), file=sys.stderr)
    afficher(chercher(depot, base, " ".join(args.mots), args.n, reclasse=not args.vite, dans=dans))
    return 0


def retrouver(args) -> int:
    base, source = CONV_BASE, CONV_SOURCE
    if args.etat:
        return conv_etat(base, source)
    if args.indexer:
        a, r, v = conv_indexer(source, base, sens=not args.sans_sens, bavard=True)
        print(tr(f"mem : {a} passages ajoutés, {r} lignes retirées (secrets), {v} vecteurs",
                 f"mem: {a} passages added, {r} lines withheld (secrets), {v} embeddings"))
        return 0
    if args.voir:
        return conv_voir(base, args.voir, args.autour)
    if not args.question:
        print(tr("mem retrouver : une question, ou --voir, --indexer, --etat",
                 "mem recall: a question, or --show, --index, --status"), file=sys.stderr)
        return 2
    question = " ".join(args.question)
    ajoutes, _, _ = conv_indexer(source, base, limite_sens=CONV_SENS_A_LA_VOLEE)
    if ajoutes > 2000:
        print(tr(f"mem : {ajoutes} passages ajoutés ; « mem retrouver --indexer » calcule leur sens",
                 f"mem: {ajoutes} passages added; \"mem recall --index\" computes their embeddings"), file=sys.stderr)
    conv_afficher(conv_chercher(base, question, args.n, args.qui, args.agent, args.depuis, args.jusqua, args.projet,
                                reclasse=args.reclasser), question)
    print(tr("Indice daté, pas un état : vérifier en direct avant de l'affirmer.",
             "A dated clue, not current state: check live before stating it."), file=sys.stderr)
    return 0


