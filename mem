def deux_noms(fr: str, en: str) -> tuple[str, str]:
    """Nom d'option ou de commande : celui de la langue choisie d'abord (l'aide le montre en premier)."""
    return (fr, en) if langue() == "fr" else (en, fr)


def commande(sub, fr: str, en: str, **kw):
    premier, autre = deux_noms(fr, en)
    return sub.add_parser(premier, aliases=[autre], **kw)


