# Reclasseur de mem : llama-server (llama.cpp) garde Qwen3-Reranker-4B chargé et note les 10 passages ensemble,
# sur un socket Unix ($XDG_RUNTIME_DIR/mem-reclasseur.sock, réservé à l'utilisateur), sans accès réseau (unshare -rn)
# quand le système le permet. Arrêté, mem classe par mots et sens, ou passe par reclasser.mjs s'il est installé.
# Modèle écrit par reclasseur/installer.sh --service (@UNSHARE@, @LLAMA@, @MODELE@ remplacés).
# mem's reranker: llama-server keeps the model loaded and scores the 10 passages in one batch, on a user-only Unix socket.
[Unit]
Description=Reclasseur de mem (llama-server, Qwen3-Reranker-4B, socket Unix)

[Service]
Type=simple
UMask=0077
ExecStartPre=-/usr/bin/rm -f %t/mem-reclasseur.sock
ExecStart=@UNSHARE@@LLAMA@ -m @MODELE@ --rerank -ngl 99 -np 10 -c 8192 --kv-unified -b 1024 -ub 1024 --no-webui --log-disable --host %t/mem-reclasseur.sock
Restart=on-failure
RestartSec=15
Nice=5
# Charge aussi bge-m3 dans Ollama pour de bon (keep_alive -1, ~1,2 Go de mémoire) ; ignoré si Ollama ne répond pas.
# MEM_SENS_GARDER=0 ne s'applique pas ici : supprimer cette ligne pour laisser Ollama le décharger.
ExecStartPost=-/usr/bin/curl -s -o /dev/null -m 120 --noproxy 127.0.0.1 http://127.0.0.1:11434/api/embed -d "{\"model\":\"bge-m3\",\"input\":\"x\",\"keep_alive\":-1}"

[Install]
WantedBy=default.target
