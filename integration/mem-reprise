#!/bin/sh
# Hook SessionStart de Claude Code (matcher « clear|compact ») : ce qu'il écrit est ajouté au contexte de la session.
# SessionStart hook (matcher "clear|compact"): its output is added to the session context.
# Plusieurs agents : MEM_POINT_NOTE donne la note de chacun (la même que pour « mem point »).
NOTE="${MEM_POINT_NOTE:-project/point-de-reprise.md}"
printf '%s\n' "Reprise après un /clear ou un /compact. Lis ton point de reprise, $NOTE dans le dossier mémoire (« mem etat » affiche ce dossier), et fais sa section « À FAIRE EN PREMIER ». Avant d'affirmer un état passé (commit, déploiement, décision, accord), cherche d'abord : mem chercher \"mots-clés\", puis vérifie en direct."
