{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear|compact",
        "hooks": [{ "type": "command", "command": "mem-reprise" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [{ "type": "command", "command": "python3 ~/.claude/hooks/mem-voisins.py", "timeout": 90 }]
      }
    ]
  }
}
